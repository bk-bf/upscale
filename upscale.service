[Unit]
Description=Bleach upscale queue (self-healing, resumes on boot)
# The queue re-derives its work from the filesystem every cycle, so it needs no
# recovery step after a power cut - it just finds whatever has no .mkv yet.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/upscale run
# Restart on any exit: a crashed run resumes mid-episode from its finished
# chunks; a clean run idles waiting for new work anyway.
Restart=always
RestartSec=30
# keep the desktop usable while this grinds
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
