#!/usr/bin/env bash
# upscale-watch — is each pipeline actually making progress?
#
#   upscale-watch          take one sample, update the health file, print it
#   upscale-watch --log    same, and append a line to health.log
#   upscale-watch --fix    additionally restart a stalled COLLECTOR (see below)
#
# Liveness is not progress. Both stalls this pipeline has had looked perfectly
# healthy from the outside: a service in `active` state, an ssh that answers, a
# log being written every 70 seconds. In one the collector was tailing a log
# from an episode that had finished twelve minutes earlier; in the other a
# process sat in do_wait forever. Nothing was down. Nothing was moving either.
#
# So the only question asked here is: has a NUMBER changed since last time?
#   local     frames upscaled, episodes delivered, bytes of the upload in flight
#   collector frames on the box, bytes of the pull in flight, episodes delivered
# If the whole tuple is identical for STALL_AFTER consecutive samples while the
# pipeline claims to be working, it is stalled - whatever its service says.
set -uo pipefail

STATE=${STATE:-$HOME/.upscale-queue}
LIB=${LIB:-/mnt/media/tv/Bleach}
# ${DESKTOP-desktop}, not ${DESKTOP:-desktop}: the colon form treats an EMPTY
# value as unset, so "DESKTOP=" - the documented way to say "that machine is off
# tonight" - silently kept checking it and reported UNREACHABLE every five
# minutes, which is exactly the noise it was meant to remove.
DESKTOP=${DESKTOP-desktop}             # ssh alias; set empty to skip the local half
HEALTH="$STATE/health"
HLOG="$STATE/health.log"
PREV="$STATE/.watch-prev"
STALL_AFTER=${STALL_AFTER:-3}          # samples, so ~15 min at a 5-minute timer
mkdir -p "$STATE"

# --- ntfy ---------------------------------------------------------------------
# Publishes to the same secret ntfy.sh topic as the rest of the server
# (NTFY_PUBLISH_URL, from Bitwarden Secrets via /run/bws/mediaserver.env), so
# alerts arrive on the phone whether or not anything else is watching.
#
# Only states a HUMAN can do something about are worth a banner. A stalled
# collector restarts itself; a box that has vanished needs a new instance and a
# new GPUHOST, and no amount of retrying here will produce one.
NTFY_ENV_FILE="${NTFY_ENV_FILE:-/run/bws/mediaserver.env}"
if [ -r "$NTFY_ENV_FILE" ]; then set -a; . "$NTFY_ENV_FILE"; set +a; fi
NTFY_URL="${NTFY_PUBLISH_URL:-}"
NOTIFIED="$STATE/.notified"
RENOTIFY=${RENOTIFY:-3600}      # do not repeat the same alarm more often than this

send_ntfy(){           # $1 title  $2 body  $3 priority  $4 tags
  [ -n "$NTFY_URL" ] || return 0
  curl -fsS --max-time 20 \
    ${NTFY_PUBLISH_USERNAME:+-u "${NTFY_PUBLISH_USERNAME}:${NTFY_PUBLISH_PASSWORD:-}"} \
    -H "Title: $1" -H "Priority: ${3:-high}" -H "Tags: ${4:-film_frames}" \
    -d "$2" "$NTFY_URL" >/dev/null 2>&1
}

# One banner per incident, not one per check. Without this a box that died at
# 02:00 would send a notification every five minutes until morning.
notify_once(){         # $1 key  $2 title  $3 body  $4 priority  $5 tags
  local key=$1 last_key='' last_at=0
  [ -r "$NOTIFIED" ] && { read -r last_key last_at < "$NOTIFIED" || true; }
  if [ "$key" = "$last_key" ] && [ "$(( now - ${last_at:-0} ))" -lt "$RENOTIFY" ]; then
    return 0
  fi
  send_ntfy "$2" "$3" "${4:-high}" "${5:-film_frames}" && printf '%s %s\n' "$key" "$now" > "$NOTIFIED"
}

do_log=0; do_fix=0
for a in "$@"; do
  case "$a" in
    --log) do_log=1 ;;
    --fix) do_fix=1; do_log=1 ;;
    --test-notify) : ;;   # handled after the env is loaded, below
    *) printf 'upscale-watch: unknown option %s\n' "$a" >&2; exit 2 ;;
  esac
done

now=$(date +%s)
ts=$(date '+%Y-%m-%d %H:%M:%S')

for a in "$@"; do
  if [ "$a" = --test-notify ]; then
    if [ -z "$NTFY_URL" ]; then
      echo "no NTFY_PUBLISH_URL (is /run/bws/mediaserver.env readable?)" >&2; exit 2
    fi
    send_ntfy "Bleach upscale: test" \
      "Alerting works. You will only get a real one if the rental needs a human." \
      default "film_frames" && { echo "sent"; exit 0; } || { echo "send FAILED" >&2; exit 1; }
  fi
done

# --- the collector and the box it drives -------------------------------------
# GPUHOST moves whenever the rented box is recreated, so read it from the same
# file the service does rather than assuming an address.
[ -r "$STATE/gpuhost.env" ] && { set -a; . "$STATE/gpuhost.env"; set +a; }
GPUHOST=${GPUHOST:-}
RWORK=${RWORK:-/root/drive}
RGPUWORK=${RGPUWORK:-/root/work}

rsh(){ timeout 45 ssh -o BatchMode=yes -o ControlPath=none -o ConnectTimeout=20 $GPUHOST "$@" 2>/dev/null; }

col_state=unknown; col_metric=''; col_detail=''
if [ -n "$GPUHOST" ]; then
  # One round trip for everything: frames upscaled so far, whether the worker is
  # alive, and whether a result is waiting. The bracket in the pgrep pattern
  # stops it matching the very ssh command that carries it - without it this
  # always answered "running".
  # `up` alone is not a progress metric: it cycles 0 -> CHUNK -> 0 with every
  # chunk, so three samples could read the same value by coincidence and trip a
  # false stall. The cumulative frame count from the log only ever increases.
  read -r c_up c_run c_out c_src c_done c_pushing < <(rsh "
      printf '%s %s %s %s %s\n' \
        \"\$(ls $RGPUWORK/src/up 2>/dev/null | wc -l)\" \
        \"\$(pgrep -f '[u]pscale-ep-rental' >/dev/null && echo 1 || echo 0)\" \
        \"\$(test -f $RWORK/out.mkv && echo 1 || echo 0)\" \
        \"\$(stat -c%s $RWORK/src.avi $RWORK/.src.avi.* 2>/dev/null | paste -sd+ | bc 2>/dev/null || echo 0)\" \
        \"\$(sed -nE 's#.* ([0-9]+)/[0-9]+ +free.*#\\1#p' $RWORK/current.log 2>/dev/null | tail -1)\" \
        \"\$(ls $RWORK/.src.avi.* >/dev/null 2>&1 && echo 1 || echo 0)\"" ) || true
  c_up=${c_up:-}; c_run=${c_run:-}; c_out=${c_out:-}; c_src=${c_src:-}; c_done=${c_done:-0}; c_pushing=${c_pushing:-0}
  # Age computed ON the box, not here. Comparing its timestamp against this
  # machine's clock makes the answer depend on the two agreeing - they were
  # already 7 s apart, and a box whose clock drifts hours would either never
  # report a dead guard or wake someone at 3am because it thought it had.
  guard_age=$(rsh "b=\$(cat $RWORK/guard.heartbeat 2>/dev/null); [ -n \"\$b\" ] && echo \$(( \$(date +%s) - b ))") || guard_age=''
  if [ -z "$c_up" ]; then
    col_state=unreachable
  else
    # Bytes of the pull in flight, so a slow transfer still counts as progress -
    # but attributed BY EPISODE. Taking the newest .part anywhere in the library
    # picked up the desktop's upload instead, so the collector looked busy
    # because the other machine was working.
    c_ep=$(sed -nE 's/^.*=== (.*) ===$/\1/p' "$STATE/log" 2>/dev/null | tail -1)
    c_part=0
    [ -n "$c_ep" ] && c_part=$(find "$LIB" -name ".$c_ep.mkv.part*" -type f -printf '%s\n' 2>/dev/null | sort -n | tail -1)
    col_metric="done=${c_done:-0} up=$c_up out=$c_out src=$c_src part=${c_part:-0}"
    # A push in progress is progress: rsync writes .src.avi.XXXXXX, so counting
    # only the finished src.avi made a 175 MB upload look like a dead collector
    # with an all-zero metric - three samples of that and --fix would have
    # restarted it mid-push, every time, all night.
    if   [ "$c_out" = 1 ];        then col_state=pulling
    elif [ "$c_run" = 1 ];        then col_state=upscaling
    elif [ "${c_pushing:-0}" = 1 ]; then col_state=pushing
    elif [ "${c_src:-0}" -gt 0 ]; then col_state=idle-with-source   # <- the stall shape
    else col_state=waiting
    fi
    col_detail="worker=$c_run"
  fi
else
  col_state=not-configured
fi

# --- the local (desktop) queue ------------------------------------------------
loc_state=unknown; loc_metric=''
if [ -n "$DESKTOP" ]; then
  # The work dir's name is the episode, and it is needed here: while an episode
  # UPLOADS, up and seg are both 0 and the finished file's size is constant, so
  # a metric built only from the scratch dir stops moving for the whole delivery
  # and reads as a stall. The bytes arriving on this side are the progress.
  # Episode names contain spaces, so the name gets a LINE of its own - reading it
  # as the fifth whitespace field put "Bleach" in the size column and the rest of
  # the title nowhere.
  l_up=''; l_seg=''; l_run=''; l_out=''; l_ep=''
  { read -r l_up l_seg l_run l_out; IFS= read -r l_ep; } < <(
    ssh -o BatchMode=yes -o ConnectTimeout=15 "$DESKTOP" '
      w=$(ls -dt /mnt/scratch/upscale-ep/*/ 2>/dev/null | head -1)
      printf "%s %s %s %s\n" \
        "$(ls "$w"up 2>/dev/null | wc -l)" \
        "$(ls "$w"seg 2>/dev/null | wc -l)" \
        "$(pgrep -f "[u]pscale-ep" >/dev/null && echo 1 || echo 0)" \
        "$(stat -c%s "$w"*.mkv 2>/dev/null | head -1)"
      basename "$w"' 2>/dev/null) || true
  if [ -z "${l_up:-}" ]; then
    loc_state=unreachable
  else
    l_part=0
    [ -n "${l_ep:-}" ] && l_part=$(find "$LIB" -name ".$l_ep.mkv.part*" -type f -printf '%s\n' 2>/dev/null | sort -n | tail -1)
    loc_metric="up=${l_up:-0} seg=${l_seg:-0} out=${l_out:-0} part=${l_part:-0}"
    if   [ "${l_run:-0}" = 1 ]; then loc_state=working
    elif [ "${l_part:-0}" -gt 0 ]; then loc_state=uploading
    else loc_state=idle; fi
  fi
else
  loc_state=not-configured
fi

# episodes delivered is the metric that matters most: it moves only when an
# episode actually lands, and it is the one number the user cares about
delivered=$(find "$LIB" -name '*.mkv' -not -name '.*' 2>/dev/null | wc -l)
sources=$(find "$LIB" -name '*.avi' -type f 2>/dev/null | wc -l)

# --- has anything moved? ------------------------------------------------------
sample="d=$delivered | col[$col_state] $col_metric | loc[$loc_state] $loc_metric"
p_sample=''; col_same=0; loc_same=0
if [ -r "$PREV" ]; then
  # shellcheck disable=SC1090
  . "$PREV"
fi
[ "$col_metric" = "${p_col_metric:-}" ] && col_same=$(( ${p_col_same:-0} + 1 )) || col_same=0
[ "$loc_metric" = "${p_loc_metric:-}" ] && loc_same=$(( ${p_loc_same:-0} + 1 )) || loc_same=0

col_verdict=OK; loc_verdict=OK
case "$col_state" in
  unreachable)      col_verdict=UNREACHABLE ;;
  not-configured)   col_verdict=- ;;
  # A source on the box with nothing running is the stall shape - but a source
  # still ARRIVING looks identical at a glance, and a 175 MB push takes minutes.
  # So it must also have stopped moving: if the byte count changed since the last
  # sample, it is a transfer, not a stall. Without this, --fix restarted the
  # collector in the middle of every push, all night.
  idle-with-source) [ "$col_same" -ge 1 ] && col_verdict=STALLED ;;
  *) [ "$col_same" -ge "$STALL_AFTER" ] && col_verdict=STALLED ;;
esac
case "$loc_state" in
  unreachable)    loc_verdict=UNREACHABLE ;;
  not-configured) loc_verdict=- ;;
  idle)           [ "$loc_same" -ge "$STALL_AFTER" ] && loc_verdict=IDLE ;;
  *) [ "$loc_same" -ge "$STALL_AFTER" ] && loc_verdict=STALLED ;;
esac

# The box runs its own guard from cron, and its heartbeat is a second, INDEPENDENT
# witness. It separates "the box is fine and simply between episodes" from "the
# box, or its cron, is gone" - which from the server look identical, because both
# are just a quiet ssh connection. Nothing here can fix that case: a box that is
# not running its own recovery needs a human.
if [ "$col_state" != unreachable ] && [ "$col_state" != not-configured ]; then
  if [ -z "${guard_age:-}" ]; then
    col_verdict=GUARD-MISSING
  elif [ "$guard_age" -gt 420 ]; then
    col_verdict=GUARD-DEAD                                  # cron runs it every 2 min
  fi
fi

# A durable record of every state change, so what happened overnight can be read
# back in the morning. health.log is one line per sample and rolls over; this is
# only the transitions, and it is never truncated.
if [ "$col_verdict$loc_verdict" != "${p_verdicts:-}" ]; then
  printf '%s  collector=%s (%s)  local=%s (%s)  delivered=%s\n' \
    "$ts" "$col_verdict" "$col_state" "$loc_verdict" "$loc_state" "$delivered" >> "$STATE/alerts.log"
fi

{ printf 'p_verdicts=%q\n' "$col_verdict$loc_verdict"
  printf 'p_col_metric=%q\np_col_same=%s\np_loc_metric=%q\np_loc_same=%s\np_when=%s\n' \
    "$col_metric" "$col_same" "$loc_metric" "$loc_same" "$now"; } > "$PREV"

{ printf 'checked   %s\n' "$ts"
  printf 'collector %-12s %-11s %s\n' "$col_verdict" "$col_state" "$col_metric"
  printf 'local     %-12s %-11s %s\n' "$loc_verdict" "$loc_state" "$loc_metric"
  printf 'delivered %s episodes\n' "$delivered"
  [ -n "${guard_age:-}" ] && printf 'box guard  last beat %ss ago\n' "$guard_age"
  [ -z "${guard_age:-}" ] && [ -n "$GPUHOST" ] && printf 'box guard  NO HEARTBEAT\n'
} > "$HEALTH"
cat "$HEALTH"

[ "$do_log" = 1 ] && printf '%s  col=%s/%s loc=%s/%s  %s\n' \
  "$ts" "$col_verdict" "$col_state" "$loc_verdict" "$loc_state" "$sample" >> "$HLOG"

# --- remediation --------------------------------------------------------------
# Only the collector is restarted, and only because restarting it is provably
# safe: it adopts a job already running on the box rather than starting a second
# one. Nothing here ever touches the remote worker or the local queue's episode -
# killing work in progress to fix a display problem is a worse outcome than the
# stall. Everything else is reported for a human to look at.
if [ "$do_fix" = 1 ] && [ "$col_verdict" = STALLED ]; then
  printf '%s  restarting upscale-collect.service (collector stalled)\n' "$ts" >> "$HLOG"
  systemctl --user restart upscale-collect.service 2>>"$HLOG" && \
    printf '%s  restart issued\n' "$ts" >> "$HLOG"
  rm -f "$PREV"     # do not immediately re-trigger on the same sample
fi

# --- tell someone -------------------------------------------------------------
# Deliberately narrow. The collector restarting itself, an episode failing once,
# a slow transfer - none of those need a person, and a banner for them teaches
# you to ignore banners.
# A box that has gone away when there is NOTHING LEFT TO DO is the expected end
# of the job, not an emergency. Without this the watchdog paged "the rental needs
# a new instance" minutes after the queue finished and the instance was correctly
# destroyed - an urgent banner for a success.
if [ "$col_verdict" != OK ] && [ "${sources:-0}" -gt 0 ] && [ "${sources:-0}" -eq "${delivered:-0}" ]; then
  say_done=1
  printf 'queue     COMPLETE - %s/%s delivered; box absence is expected\n' "$delivered" "$sources" >> "$HEALTH"
  case "$col_verdict" in *) col_verdict=DONE ;; esac
fi

case "$col_verdict" in
  UNREACHABLE)
    notify_once "col-unreachable" "Bleach upscale: rental unreachable" \
      "The GPU box is not answering. It likely needs a new Vast.ai instance, and GPUHOST in ~/.upscale-queue/gpuhost.env updated. $delivered episodes delivered so far." \
      urgent "warning,film_frames" ;;
  GUARD-DEAD|GUARD-MISSING)
    notify_once "col-guard" "Bleach upscale: box guard not running" \
      "The GPU box answers but its own guard has stopped, so it can no longer restart a dead job by itself. $delivered delivered." \
      high "warning,film_frames" ;;
  STALLED)
    # only if it is STILL stalled after --fix has had a go at it
    if [ "${col_same:-0}" -ge "$(( STALL_AFTER + 2 ))" ]; then
      notify_once "col-stuck" "Bleach upscale: collector stuck" \
        "The collector has not moved for about $(( col_same * 5 )) minutes and restarting it has not helped. $delivered delivered." \
        high "warning,film_frames"
    fi ;;
  *)
    # recovery is worth exactly one quiet line, and only if something was wrong
    if [ -r "$NOTIFIED" ]; then
      read -r lk _ < "$NOTIFIED" || lk=''
      if [ -n "$lk" ] && [ "$lk" != recovered ]; then
        send_ntfy "Bleach upscale: recovered" \
          "Back to $col_state. $delivered episodes delivered." min "white_check_mark" \
          && printf 'recovered %s\n' "$now" > "$NOTIFIED"
      fi
    fi ;;
esac

case "$col_verdict$loc_verdict" in
  *STALLED*|*UNREACHABLE*|*GUARD*) exit 1 ;;
esac
exit 0
