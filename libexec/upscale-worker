#!/usr/bin/env bash
# upscale-ep — episode upscale on the desktop, split into overlappable phases.
#
#   upscale-ep run     <remote-src> [remote-dest-dir]   fetch + process + deliver
#   upscale-ep fetch   <remote-src>                     pull source (idempotent)
#   upscale-ep process <remote-src>                     GPU work, no network
#   upscale-ep deliver <remote-src> [remote-dest-dir]   upload, verify, archive
#   upscale-ep box     <local-src> <out.mkv>            process only, no network
#   upscale-ep status | pause | resume | stop
#
# The phases exist so upscale-queue can overlap them across episodes: the server
# link is ~2.2 MB/s (WiFi repeater + CAKE shaper), so ~5-6 min/episode of
# transfer is unavoidable, but it is free if it happens while the GPU is busy on
# a different episode.
#
# Design notes:
#   * Four concurrent workers. One process leaves the GPU at ~65% between frames
#     (9.97 fps); four peg it at 99% (measured 3.6x with animejanai-suc). Beyond
#     four gains nothing - the GPU becomes the wall.
#   * All workers write into ONE output dir. Filenames are preserved and
#     distinct, so the merged dir is the sequence; nothing to reassemble.
#   * All work is on ONE filesystem so chunk staging hardlinks instead of
#     copying. Hardlinks cannot cross devices.
#   * Frame counts are asserted at every stage; a dropped frame aborts the run
#     rather than silently shortening the episode.
#   * Delivery is verified by size BEFORE the original is archived, and the move
#     uses `mv -n`, so a rerun can never clobber an archived original.
set -euo pipefail

REMOTE=${REMOTE:-ubuntu}
LIB=${LIB:-/mnt/media/tv/Bleach}
ARCHIVE=${ARCHIVE:-$LIB/.upscale-originals}
MODEL=${MODEL:-animejanai-suc}
MODEL_DIR=${MODEL_DIR:-$HOME/upscale-bench/models_janai}
BIN=${BIN:-$HOME/upscale-bench/bin/realesrgan-ncnn-vulkan}
WORKERS=${WORKERS:-8}   # measured: 4->33.1 fps, 8->38.7, 12->36.4 (contention)
CHUNK=${CHUNK:-2000}
SCALE=${SCALE:-2}
CRF=${CRF:-18}
PRESET=${PRESET:-veryfast}
ENC_THREADS=${ENC_THREADS:-4}   # keep the background encode off the workers' cores
# ffmpeg 8.1.2 mis-decodes MPEG-4 ASP (XviD/DivX): it silently produces blocky,
# smeared frames from a byte-identical source that 6.x/7.x decode correctly.
# The model then faithfully upscales the corruption. Use a known-good build for
# DECODING; the system ffmpeg is fine for encoding.
FFDEC=${FFDEC:-$HOME/ffdec/ffmpeg}
[ -x "$FFDEC" ] || FFDEC=ffmpeg
WORK=${WORK:-/mnt/scratch/upscale-ep}
STATE=${STATE:-$HOME/.upscale-ep}

mkdir -p "$STATE"
JOB="$STATE/job"; PAUSE="$STATE/pause"; STOP="$STATE/stop"; LOG="$STATE/log"
say(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG" >&2; }
die(){ printf 'upscale-ep: %s\n' "$*" >&2; exit 1; }
pngs(){ find "$1" -maxdepth 1 -name '*.png' -type f 2>/dev/null | wc -l; }
# THE WORKER DECLARES ITS PHASE. Inferring it from `pgrep` was guesswork that
# collapsed several minutes-long activities into one word, so a bar could only
# be drawn for one of them and everything else looked stuck.
#
#   phase  done  total  started_epoch  unit
#
# `done`/`total` are in `unit` (frames, chunks, bytes) so a reader can draw a
# bar and an ETA for THIS phase, not for the episode.
phase_set(){
  printf '%s %s %s %s %s\n' "$1" "${2:-0}" "${3:-0}" "$(date +%s)" "${4:-}" \
    > "$STATE/phase.tmp" 2>/dev/null && mv -f "$STATE/phase.tmp" "$STATE/phase" 2>/dev/null || true
}
# Network ops retry with backoff: the server rebooting mid-run must pause the
# pipeline, not fail the episode.
retry(){ local n=0 max=${RETRIES:-60}
  until "$@"; do n=$((n+1)); [ "$n" -ge "$max" ] && return 1
    say "retry $n/$max: $1 ..."; sleep $(( n<10 ? 10 : 30 )); done; }
vframes(){ ffprobe -v error -count_frames -select_streams v \
             -show_entries stream=nb_read_frames -of csv=p=0 "$1"; }

cmd_status(){
  [ -f "$JOB" ] || { echo "no job"; return 0; }
  # shellcheck disable=SC1090
  . "$JOB"
  local segs=0 chunks state=running
  [ -d "$SEGDIR" ] && segs=$(find "$SEGDIR" -name 'seg_*.mkv' 2>/dev/null | wc -l)
  chunks=$(( (TOTAL + CHUNK - 1) / CHUNK ))
  [ -f "$PAUSE" ] && state=paused
  [ -f "$STOP" ]  && state=stopping
  kill -0 "$PID" 2>/dev/null || state="not running"
  local df=$(( segs * CHUNK )); [ "$df" -gt "$TOTAL" ] && df=$TOTAL
  printf 'episode : %s\nstate   : %s (pid %s)\nprogress: %d/%d chunks, %d/%d frames (%d%%)\n' \
    "$(basename "$SRC")" "$state" "$PID" "$segs" "$chunks" "$df" "$TOTAL" \
    "$(( TOTAL ? df*100/TOTAL : 0 ))"
  if [ -f "$STATE/started" ] && [ "$df" -gt 0 ]; then
    awk -v f="$df" -v e="$(( $(date +%s) - $(cat "$STATE/started") ))" -v r="$((TOTAL-df))" \
      'BEGIN{fps=(e>0)?f/e:0; printf "rate    : %.2f fps  elapsed %dm  eta %dm\n", fps, e/60, (fps>0)?r/fps/60:0}'
  fi
}

# Same facts as cmd_status, as JSON, for anything that is not a human: the web
# UI polls this over ssh rather than scraping the text form, which would break
# the moment a label is reworded.
#
# Always valid JSON, including when there is no job at all - a consumer should
# never have to distinguish "no job" from "ssh failed" by parse error.
cmd_status_json(){
  local segs=0 chunks=0 state=idle df=0 pct=0 fps=0 elapsed=0 eta=0 ep="" phase=idle pp=0 transfer=""
  # THE JOB FILE IS NOT THE JOB. do_process writes it and deletes it again when
  # the GPU work ends, so it exists for only one of the three phases. Fetch and
  # deliver are minutes each - ~900 MB over a ~2 MB/s link - and reading $JOB
  # alone reported "idle" while an 861 MB upload was in flight.
  #
  # The worker PROCESS is the ground truth that something is happening; the job
  # file, the GPU and rsync then say which phase it is in.
  local wargs=""
  wargs=$(pgrep -af '[u]pscale-worker (run|fetch|process|deliver)' 2>/dev/null | head -1) || wargs=""
  if [ -n "$wargs" ]; then
    state=working
    # Everything after the phase word is the path - NOT the last space-separated
    # token. Episode titles are full of spaces ("A Gentle Right Arm SDTV.mkv"),
    # so ${wargs##* } returned "HDTV-720p.mkv".
    #
    # This is a FALLBACK. With phases overlapping, several workers run at once -
    # one on the card, another uploading a finished episode - and pgrep lists
    # whichever it likes. The job file below names the episode actually being
    # processed, and it wins when it exists.
    ep=$(printf '%s' "$wargs" | sed -E 's#^.*upscale-worker (run|fetch|process|deliver) ##')
    ep=$(basename "$ep")
  fi
  if [ -f "$JOB" ]; then
    # shellcheck disable=SC1090
    . "$JOB"
    ep=$(basename "$SRC")
    [ -d "$SEGDIR" ] && segs=$(find "$SEGDIR" -name 'seg_*.mkv' 2>/dev/null | wc -l)
    chunks=$(( (TOTAL + CHUNK - 1) / CHUNK ))
    state=running
    [ -f "$PAUSE" ] && state=paused
    [ -f "$STOP" ]  && state=stopping
    # Only "not running" if there is genuinely no worker. The job file belongs
    # to the PREVIOUS episode until the new one writes its own, so a stale PID
    # here reported "not running" while a worker was demonstrably fetching and
    # extracting - and the queue then showed the episode as merely queued.
    if ! kill -0 "$PID" 2>/dev/null; then
      [ -n "$wargs" ] && state=working || state="not running"
    fi
    # Completed segments PLUS the frames already upscaled in the current chunk.
    # Counting only finished segments left rate and eta empty for the first
    # ~3 minutes of every episode, and made the bar jump once per chunk instead
    # of moving - the queue's own display has counted both for this reason.
    local inflight=0
    [ -n "${UPDIR:-}" ] && [ -d "$UPDIR" ] && inflight=$(pngs "$UPDIR")
    df=$(( segs * CHUNK + inflight )); [ "$df" -gt "$TOTAL" ] && df=$TOTAL
    pct=$(( TOTAL ? df * 100 / TOTAL : 0 ))
    [ -f "$STATE/started" ] && elapsed=$(( $(date +%s) - $(cat "$STATE/started") ))
    # RATE FROM COMPLETED SEGMENTS. Sampling frames-in-flight is noisy: each
    # chunk starts with eight model loads that produce almost nothing, so a
    # window opened just after a chunk boundary reported 11.8 fps for a pipeline
    # measurably doing 19. Segment mtimes are exact chunk completion times, so
    # the last few give a stable rate with no startup skew.
    local _segs_by_time _k _t_new _t_old _span
    if [ "${segs:-0}" -ge 2 ]; then
      mapfile -t _segs_by_time < <(find "$SEGDIR" -name 'seg_*.mkv' -printf '%T@\n' 2>/dev/null | sort -n)
      _k=${#_segs_by_time[@]}
      if [ "$_k" -ge 2 ]; then
        local _use=4; [ "$_k" -lt "$_use" ] && _use=$_k
        _t_new=${_segs_by_time[$((_k-1))]}
        _t_old=${_segs_by_time[$((_k-_use))]}
        read -r fps eta < <(awk -v a="$_t_old" -v b="$_t_new" -v c="$((_use-1))" \
          -v ch="$CHUNK" -v r="$((TOTAL-df))" 'BEGIN{
            s=b-a; x=(s>0)? (c*ch)/s : 0; printf "%.2f %d\n", x, (x>0)? r/x : 0 }')
      fi
    fi
    # Fallback only: before two segments exist there is nothing to time between,
    # so fall back to the phase clock. Once segments exist the mtime figure
    # above wins - this used to run unconditionally and clobber it.
    if [ "${fps:-0}" = 0 ] && [ -f "$STATE/upscale_started" ]; then
      local _t0=0 _b=0
      read -r _t0 _b < "$STATE/upscale_started" || true
      local _dt=$(( $(date +%s) - ${_t0:-0} )) _dfr=$(( df - ${_b:-0} ))
      if [ "$_dt" -gt 0 ] && [ "$_dfr" -gt 0 ]; then
        read -r fps eta < <(awk -v f="$_dfr" -v e="$_dt" -v r="$((TOTAL-df))" \
          'BEGIN{ x=(e>0)?f/e:0; printf "%.2f %d\n", x, (x>0)?r/x:0 }')
      fi
    fi
  fi
  # A GPU actually turning is the one thing the job file cannot tell you: the
  # file persists across a crash, so "running" alone would lie.
  local busy=false
  pgrep -f '[r]ealesrgan-ncnn-vulkan' >/dev/null 2>&1 && busy=true

  # $FRAMES/$OUT/$LOCAL are assigned after this branch exits, so they are unbound
  # here; the job file carries SEGDIR and the whole work dir hangs off it.
  local wdir="" framesdir="" extracted=0 _r
  if [ -n "${SEGDIR:-}" ]; then
    wdir=$(dirname "$SEGDIR")
  elif [ -n "$ep" ]; then
    # do_process DELETES the job file when the GPU work ends, so during muxing
    # and delivery there is no SEGDIR to derive from - and the delivered size,
    # which is the only total the upload bar can use, read as 0. Find the work
    # dir by the episode name across the scratch roots this machine uses.
    for _r in "$WORK" "$HOME/upscale-scratch" /mnt/scratch/upscale-ep; do
      [ -d "$_r/${ep%.*}" ] && { wdir="$_r/${ep%.*}"; break; }
    done
  fi
  if [ -n "$wdir" ]; then
    framesdir="$wdir/frames"
    [ -d "$framesdir" ] && extracted=$(pngs "$framesdir")
  fi

  # THE PHASE, AS THE WORKER DECLARED IT, with progress and an ETA of its own.
  #
  # Each phase measures a different thing - frames extracted, chunks verified,
  # bytes moved - so each carries its own unit, its own bar and its own ETA.
  # One episode-level number could not represent any of them, which is why a
  # 39%-complete episode sat at "39%" through minutes of verifying and read as
  # stuck.
  local pdone=0 ptot=0 pt0=0 punit="" pelapsed=0 peta=0
  if [ -f "$STATE/phase" ]; then
    read -r phase pdone ptot pt0 punit < "$STATE/phase" 2>/dev/null || true
    phase=${phase:-idle}
    [ "${pt0:-0}" -gt 0 ] && pelapsed=$(( $(date +%s) - pt0 ))
  fi
  # REALITY OVERRIDES THE MARKER. The marker is what the worker last declared;
  # what the machine is visibly doing is what is true. A worker that died, or
  # one from before markers existed, leaves a stale declaration - and trusting
  # it showed "upscaling" through muxing and uploading.
  local ffargs="" fpargs="" live=""
  ffargs=$(pgrep -af '[f]fmpeg' 2>/dev/null | tr '\n' ' ') || ffargs=""
  fpargs=$(pgrep -af '[f]fprobe' 2>/dev/null | tr '\n' ' ') || fpargs=""
  if pgrep -f '[r]sync .*\.mkv' >/dev/null 2>&1;               then live=delivering
  elif pgrep -f '[r]sync ' >/dev/null 2>&1;                     then live=fetching
  elif [ "$busy" = true ];                                      then live=upscaling
  elif printf '%s' "$ffargs" | grep -q -- '-f concat';          then live=muxing
  elif printf '%s' "$ffargs" | grep -q 'fps_mode passthrough';  then live=extracting
  elif printf '%s' "$ffargs" | grep -q 'libx264';               then live=encoding
  elif printf '%s' "$fpargs" | grep -q 'seg_';                  then live=verifying
  elif printf '%s' "$fpargs" | grep -q 'count_frames';          then live=counting
  fi
  # Nothing running at all means idle, whatever the marker still says. The
  # marker is the last thing a worker declared, and a finished worker declares
  # nothing - so an ended episode kept reporting "upscaling" for ever.
  if [ -z "$wargs" ] && [ -z "$live" ] && [ -z "$transfer" ]; then
    phase=idle; pp=-1; pdone=0; ptot=0; punit=""; pelapsed=0; peta=0
  fi
  if [ -n "$live" ] && [ "$live" != "$phase" ]; then
    # A phase the marker did not describe has no numbers of its own; say so
    # rather than carrying the previous phase's totals into it.
    phase=$live; pdone=0; ptot=0; punit=""; pelapsed=0; peta=0
  fi

  # Live measures, because the marker records where a phase STARTED, not where
  # it has got to.
  case "$phase" in
    extracting) pdone=$extracted ;;
    upscaling)  pdone=$df ;;
  esac
  if [ "${ptot:-0}" -gt 0 ] && [ "${pdone:-0}" -ge 0 ]; then
    pp=$(( pdone * 100 / ptot )); [ "$pp" -gt 100 ] && pp=100
    if [ "$pelapsed" -gt 2 ] && [ "$pdone" -gt 0 ]; then
      peta=$(awk -v d="$pdone" -v t="$ptot" -v e="$pelapsed" \
               'BEGIN{ r=(e>0)? d/e : 0; printf "%d", (r>0)? (t-d)/r : 0 }')
    fi
  else
    pp=-1                       # indeterminate: counting, muxing, archiving
  fi
  # A worker process with no marker at all (an episode started before this
  # existed) still reports something honest rather than "idle".
  if [ -n "$wargs" ] && [ "$phase" = idle ]; then phase=working; fi

  printf '{"host":"%s","state":"%s","episode":"%s","chunks_done":%d,"chunks_total":%d,' \
    "$(hostname)" "$state" "${ep//\"/}" "$segs" "$chunks"
  printf '"frames_done":%d,"frames_total":%d,"percent":%d,"fps":%s,"elapsed_s":%d,"eta_s":%d,' \
    "$df" "${TOTAL:-0}" "$pct" "${fps:-0}" "$elapsed" "${eta:-0}"
  # phase_percent is progress THROUGH THE CURRENT PHASE; percent stays whole-
  # episode. out_bytes/fetch_bytes let the server measure the two transfer
  # phases, since the other end of each is a file on the server.
  local outb=0 fetchb=0 f
  if [ -n "$wdir" ]; then
    for f in "$wdir"/*.mkv "$wdir"/*.mkv.part; do
      [ -f "$f" ] && outb=$(stat -c%s "$f" 2>/dev/null || echo 0)
    done
    for f in "$wdir/src" "$wdir/src.part"; do
      [ -f "$f" ] && fetchb=$(stat -c%s "$f" 2>/dev/null || echo 0)
    done
  fi
  printf '"gpu_busy":%s,"phase":"%s","transfer":"%s","phase_percent":%d,"phase_done":%d,"phase_total":%d,' \
    "$busy" "$phase" "$transfer" "$pp" "${pdone:-0}" "${ptot:-0}"
  printf '"phase_unit":"%s","phase_elapsed_s":%d,"phase_eta_s":%d,"frames_extracted":%d,' \
    "${punit:-}" "$pelapsed" "$peta" "$extracted"
  # The scratch dir of the RUNNING job, not this invocation's default. `status`
  # is a separate process and does not inherit the queue's WORK, so it reported
  # /mnt/scratch while the job was actually on the M.2 - the exact fact the disk
  # change was made to control.
  local wreal="$WORK"
  [ -n "$wdir" ] && wreal=$(dirname "$wdir")
  printf '"out_bytes":%d,"fetch_bytes":%d,"work":"%s"}\n' "$outb" "$fetchb" "$wreal"
}

# PROCESS-ONLY MODE. A rented GPU box has no route back into the home network -
# CGNAT, no inbound ports, not on the tailnet - so it can neither fetch its own
# work nor deliver its result. In `box` mode the SERVER drives both transfers
# and the worker only does the GPU half, which is the one thing that machine is
# actually for. This is what lets ONE worker serve every machine; the rental
# used to need a hand-copied fork of this file to do the same job.
BOX=0
PHASE="${1:-}"
case "$PHASE" in
  status) if [ "${2:-}" = --json ]; then cmd_status_json; else cmd_status; fi; exit 0 ;;
  pause)  touch "$PAUSE"; echo "pausing after current chunk"; exit 0 ;;
  resume) rm -f "$PAUSE"; echo resumed; exit 0 ;;
  stop)   touch "$STOP";  echo "stopping after current chunk"; exit 0 ;;
  run|fetch|process|deliver) shift ;;
  box)    BOX=1; shift ;;
  *) { sed -n '2p' "$0"; grep '^#   upscale-ep ' "$0"; } |
       sed 's/^# \{0,1\}//'; exit 1 ;;
esac

SRC_REMOTE="${1:?need remote source path}"
BASE=$(basename "${SRC_REMOTE%.*}")
W="$WORK/$BASE"
FRAMES="$W/frames"; UP="$W/up"; SEGDIR="$W/seg"; LOCAL="$W/src"; OUT="$W/$BASE.mkv"
# Box mode is handed both paths outright: $1 is a file that is ALREADY local
# (the server pushed it) and $2 is where the server will come looking for the
# result. Everything else - scratch, chunking, resume - is unchanged.
if [ "$BOX" = 1 ]; then
  LOCAL="$SRC_REMOTE"
  OUT="${2:?need an output path:  upscale-ep box <local-src> <out.mkv>}"
  [ -f "$LOCAL" ] || die "box mode: source is not local: $LOCAL"
fi

do_fetch(){
  [ "$BOX" = 1 ] && return 0      # the server already pushed it
  mkdir -p "$W"
  [ -f "$LOCAL" ] && return 0
  say "fetching $(basename "$SRC_REMOTE")"
  phase_set fetching 0 0 bytes
  retry rsync -q --partial "$REMOTE:$SRC_REMOTE" "$LOCAL.part" || die "fetch failed: $SRC_REMOTE"
  mv "$LOCAL.part" "$LOCAL"          # rename only on success: a partial file
}                                    # must never look like a complete fetch


# Two independent decoders must agree before a single frame is upscaled.
#
# ffmpeg 8.1.2 silently mis-decodes MPEG-4 ASP: byte-identical input, visibly
# corrupt output, correct frame COUNT - so every count-based check passed and two
# episodes shipped damaged. Content checks are the only thing that catches this,
# and it matters more on rented machines whose ffmpeg version is unknown.
#
# Cost is ~5 seconds per episode: five sampled frames, decoded twice, compared.
verify_decoder(){
  local ref="${FFDEC_REF:-ffmpeg}" bad=0 n=0 t d
  [ "$(command -v "$FFDEC")" = "$(command -v "$ref")" ] && { say "only one decoder available - cross-check skipped"; return 0; }
  for t in 10 40 70 300 900; do
    "$FFDEC" -v error -ss "$t" -i "$LOCAL" -frames:v 1 "$W/.d1.png" -y 2>/dev/null || continue
    "$ref"   -v error -ss "$t" -i "$LOCAL" -frames:v 1 "$W/.d2.png" -y 2>/dev/null || continue
    n=$((n+1))
    d=$("$FFDEC" -v error -i "$W/.d1.png" -i "$W/.d2.png" \
        -lavfi "blend=all_mode=difference,format=gray,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" \
        -f null - 2>/dev/null | grep -o '=[0-9.]*$' | tr -d '=' | head -1)
    awk -v x="${d:-0}" 'BEGIN{exit !(x>0.5)}' && { bad=$((bad+1)); say "decoder mismatch at ${t}s (mean diff ${d})"; }
  done
  rm -f "$W/.d1.png" "$W/.d2.png"
  [ "$n" -gt 0 ] || { say "decoder cross-check inconclusive"; return 0; }
  [ "$bad" -eq 0 ] || die "DECODER DISAGREEMENT on $bad/$n frames - refusing to upscale corrupt input. Check ffmpeg versions ($FFDEC vs $ref)."
  say "decoder cross-check passed ($n frames)"
}

do_process(){
  [ -f "$LOCAL" ] || die "no local source; run fetch first"
  [ -x "$BIN" ] || die "upscaler missing: $BIN"
  [ -f "$MODEL_DIR/$MODEL.param" ] || die "model missing: $MODEL_DIR/$MODEL.param"
  [ -f "$OUT" ] && { say "already processed: $BASE"; return 0; }
  mkdir -p "$FRAMES" "$UP" "$SEGDIR"; rm -f "$PAUSE" "$STOP"

  local FPS TOTAL
  FPS=$(ffprobe -v error -select_streams v -show_entries stream=r_frame_rate -of csv=p=0 "$LOCAL")
  phase_set counting 0 0            # a full decode of the source; no progress to report
  TOTAL=$(vframes "$LOCAL")
  say "$BASE: $TOTAL frames @ $FPS, $MODEL x$SCALE, $WORKERS workers"
  verify_decoder

  cat > "$JOB" <<EOF
SRC="$SRC_REMOTE"
TOTAL=$TOTAL
CHUNK=$CHUNK
SEGDIR="$SEGDIR"
UPDIR="$UP"
PID=$$
EOF
  date +%s > "$STATE/started"

  # -fps_mode passthrough is essential: the default silently drops or
  # duplicates frames to hit a target rate.
  if [ "$(pngs "$FRAMES")" != "$TOTAL" ]; then
    phase_set extracting 0 "$TOTAL" frames
    rm -f "$FRAMES"/*.png
    "$FFDEC" -v error -i "$LOCAL" -fps_mode passthrough "$FRAMES/%06d.png" -y
    local got; got=$(pngs "$FRAMES")
    [ "$got" = "$TOTAL" ] || die "extracted $got of $TOTAL frames"
    say "extracted $got frames"
  fi


  mapfile -t ALL < <(find "$FRAMES" -maxdepth 1 -name '*.png' -type f | sort)
  [ "${#ALL[@]}" = "$TOTAL" ] || die "listed ${#ALL[@]} files, expected $TOTAL"

  # Rate and ETA must measure the GPU phase, not the episode. $STATE/started is
  # written before extraction, and extraction is minutes (276 s for a 68,715
  # frame double episode) with no frames upscaled - averaging that in reported
  # 5.8 fps for a pipeline running at 20.6, and turned a 54-minute ETA into 3h.
  #
  # The frame count at this moment is recorded too: a resumed episode starts
  # with chunks already done, and dividing those by a clock that starts now
  # would read as impossibly fast.
  local _s0=0
  [ -d "$SEGDIR" ] && _s0=$(find "$SEGDIR" -name 'seg_*.mkv' 2>/dev/null | wc -l)
  printf '%s %s\n' "$(date +%s)" "$(( _s0 * CHUNK ))" > "$STATE/upscale_started"

  local i=0 idx=0 seg n staged got enc_pid="" wpids wp
  while [ "$i" -lt "$TOTAL" ]; do
    idx=$((idx+1))
    seg=$(printf '%s/seg_%04d.mkv' "$SEGDIR" "$idx")
    n=$CHUNK; [ $((i+n)) -gt "$TOTAL" ] && n=$((TOTAL-i))
    if [ -f "$seg" ] && [ "$(vframes "$seg")" = "$n" ]; then
      phase_set verifying "$idx" "$(( (TOTAL + CHUNK - 1) / CHUNK ))" chunks
      say "chunk $idx complete, skipping"; i=$((i+n))
      # Re-base the rate clock past every skipped chunk. Verifying a banked
      # segment means decoding 2000 frames of 1920x1440, so a resumed episode
      # spends minutes here with no frames upscaled - and counting that as
      # upscaling time reported 9.5 fps for a pipeline doing 20.
      printf '%s %s\n' "$(date +%s)" "$i" > "$STATE/upscale_started"
      continue
    fi
    while [ -f "$PAUSE" ]; do sleep 5; done
    [ -f "$STOP" ] && { say "stopped after chunk $((idx-1))"; break; }

    phase_set upscaling "$i" "$TOTAL" frames
    rm -rf "$W/shard"; mkdir -p "$W/shard"
    for ((k=i; k<i+n; k++)); do
      d="$W/shard/$(( (k-i) % WORKERS ))"; mkdir -p "$d"; ln -f "${ALL[$k]}" "$d/"
    done
    staged=0; for ((p=0; p<WORKERS; p++)); do staged=$((staged + $(pngs "$W/shard/$p"))); done
    [ "$staged" = "$n" ] || die "chunk $idx staged $staged of $n"

    mkdir -p "$UP"
    # Collect worker PIDs and wait on those specifically. A bare `wait` waits for
    # ALL children, which would reap the background encode from the previous
    # chunk and make the later `wait "$enc_pid"` fail with "not a child".
    wpids=()
    for ((p=0; p<WORKERS; p++)); do
      "$BIN" -i "$W/shard/$p" -o "$UP" -m "$MODEL_DIR" -n "$MODEL" -s "$SCALE" -f png >/dev/null 2>&1 &
      wpids+=($!)
    done
    for wp in "${wpids[@]}"; do wait "$wp" || die "an upscale worker failed"; done
    got=$(pngs "$UP"); [ "$got" = "$n" ] || die "chunk $idx upscaled $got of $n"

    # Hand the frames off by RENAME (instant, same filesystem) and encode them in
    # the background, so the GPU starts the next chunk immediately. Profiling
    # showed encode (~9s) and the delete of 2000 PNGs (~14s) cost 26% of wall
    # time with the GPU sitting at 1-2%.
    encdir="$W/enc_$idx"; mv "$UP" "$encdir"; mkdir -p "$UP"
    [ -n "$enc_pid" ] && { wait "$enc_pid" || die "background encode failed"; }
    (
      # -threads: x264 defaults to every core and would fight the upscale workers
      # it now runs alongside. It only has to keep up with one chunk per ~50s, so
      # a small pool is plenty and leaves the GPU fed.
      ffmpeg -v error -threads "$ENC_THREADS" -framerate "$FPS" -pattern_type glob -i "$encdir/*.png" \
             -c:v libx264 -crf "$CRF" -preset "$PRESET" -pix_fmt yuv420p "$seg" -y || exit 1
      e=$(vframes "$seg"); [ "$e" = "$n" ] || { echo "chunk $idx: encoded $e of $n" >&2; exit 1; }
      rm -rf "$encdir"
    ) &
    enc_pid=$!

    say "chunk $idx/$(( (TOTAL+CHUNK-1)/CHUNK )) upscaled ($((i+n))/$TOTAL)"
    i=$((i+n))
  done
  # the last chunk's encode is still running in the background
  [ -n "$enc_pid" ] && { wait "$enc_pid" || die "final background encode failed"; }

  # ffmpeg concat: ' inside a quoted path must be written '\''  - episode
  # titles like "A Shinigami's Work" otherwise truncate the filename.
  phase_set muxing 0 0
  find "$SEGDIR" -name 'seg_*.mkv' | sort |
    sed -e "s/'/'\\\\''/g" -e "s|^|file '|" -e "s|$|'|" > "$SEGDIR/list"
  # Mux the ORIGINAL audio, SUBTITLES and FONT ATTACHMENTS back in. The video is
  # rebuilt from frames, so it carries none of them.
  #
  # This mapped only video and audio for its whole life, which was invisible on
  # Bleach - XviD sources with nothing else in them - and silently shipped every
  # Gintama episode with no subtitles and no fonts. A subtitled show came out
  # unwatchable and the only fix was a remux, because the upscale itself was
  # fine. 1:s? and 1:t? are what carry the ass track and the ttf it needs.
  #
  # Every map is optional (?) so a source with no audio, no subs or no fonts
  # still succeeds - do not drop the ? to "tighten" this.
  # -f matroska: ffmpeg cannot infer a container from the ".part" suffix
  ffmpeg -v error -f concat -safe 0 -i "$SEGDIR/list" -i "$LOCAL" \
         -map 0:v:0 -map "1:a?" -map "1:s?" -map "1:t?" \
         -c copy -f matroska "$OUT.part" -y
  local final; final=$(vframes "$OUT.part")
  [ "$final" = "$TOTAL" ] || die "FINAL MISMATCH: $final frames, source had $TOTAL"

  # NORMALISE THE CONTAINER TIMESTAMPS.
  #
  # The concat muxer leaves the video track starting 20 ms after the container's
  # zero. ffmpeg plays it, mpv plays it, and Jellyfin direct-plays it - but
  # Fladder's libmpv backend renders no video at all: it allocates the texture,
  # Skia rejects it ("Trying to use texture on two GrContexts!"), and the video
  # output is disposed and recreated in a loop while audio runs on. You get the
  # first frame frozen on screen. An episode remuxed from a finished file starts
  # at 0 and plays, which is the only reason this was ever found.
  #
  # ffmpeg cannot fix it with a stream copy - -output_ts_offset, -itsoffset and
  # a plain remux all leave it at 20 ms, because the Matroska muxer re-derives
  # cluster timecodes from the first packet. mkvmerge rebases them. Container
  # rewrite only, no re-encode, ~30 s.
  if command -v mkvmerge >/dev/null 2>&1; then
    if mkvmerge -q -o "$OUT.norm" "$OUT.part" 2>/dev/null; then
      local nf; nf=$(vframes "$OUT.norm") || nf=0
      if [ "$nf" = "$TOTAL" ]; then
        mv -f "$OUT.norm" "$OUT.part"
        say "timestamps normalised (video starts at 0)"
      else
        rm -f "$OUT.norm"
        say "WARNING: normalise produced $nf of $TOTAL frames - keeping the original"
      fi
    else
      rm -f "$OUT.norm"
      say "WARNING: mkvmerge failed; delivering without normalising"
    fi
  else
    say "WARNING: mkvmerge not installed - video will start at 20 ms and Fladder's libmpv backend will show no video (install mkvtoolnix)"
  fi

  mv "$OUT.part" "$OUT"
  rm -rf "$FRAMES" "$UP" "$W/shard" "$SEGDIR"
  rm -f "$JOB" "$STATE/started"
  say "processed $final frames, $(du -h "$OUT" | cut -f1)"
}

# Identity, not just shape.
#
# The episode that nearly shipped had the right duration, the right frame count
# and the right stream layout. It was simply a DIFFERENT EPISODE, and every
# count-based check in do_deliver passed it. Only comparing content catches that.
#
# This check existed, but only in `upscale collect` - the path that drove the
# rented box. Everything delivered locally by `upscale run` / `upscale ep` went
# out unverified.
#
# Best-of-N, not all-of-N, and that is not laziness: `-ss` before `-i` seeks to
# the nearest keyframe, and an MPEG-4 source and an h264 output do not share
# keyframe positions, so individual samples legitimately compare different frames
# and score low - 13-18 dB on a known-good episode. A WRONG episode has no good
# match at ANY timestamp; the near-miss scored 13.6 dB at its best, against
# 29-44 dB for correct ones.
#
# Decoding uses $FFDEC for the same reason extraction does: the source is
# MPEG-4 ASP, and a decoder that lies about it makes the comparison meaningless.
IDENT_MIN_DB=${IDENT_MIN_DB:-20}
ident_psnr(){          # $1 delivered mkv  $2 source -> best dB seen, "0" on error
  local t best=0 p w h tmp dur
  local -a times
  tmp=$(mktemp -d) || { printf '0'; return 0; }
  read -r w h < <(ffprobe -v error -select_streams v -show_entries stream=width,height \
                    -of csv=p=0 "$2" 2>/dev/null | tr ',' ' ') || true
  if [ -z "${w:-}" ]; then rm -rf "$tmp"; printf '0'; return 0; fi
  # Sample at FRACTIONS of the duration, never fixed timestamps. The original
  # 120/400/700/1000/1300 set was written for 23-minute episodes: on anything
  # shorter every seek falls past the end, every sample is skipped, and the
  # function returns 0 - which reads as "wrong episode" and refuses a delivery
  # that is perfectly correct. Caught by a 3-second round-trip test.
  dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$2" 2>/dev/null) || dur=0
  mapfile -t times < <(awk -v d="${dur:-0}" 'BEGIN{ if (d <= 0) d = 0;
      split("10 25 45 65 85", p, " "); for (i = 1; i <= 5; i++) printf "%.2f\n", d * p[i] / 100 }')
  for t in "${times[@]}"; do
    "$FFDEC" -v error -ss "$t" -i "$1" -frames:v 1 "$tmp/a.png" -y 2>/dev/null || continue
    "$FFDEC" -v error -ss "$t" -i "$2" -frames:v 1 "$tmp/b.png" -y 2>/dev/null || continue
    # NOT -v error on this one: the psnr filter reports at info level, and -v
    # error hides the very line being parsed - which silently scores everything 0.
    p=$("$FFDEC" -hide_banner -i "$tmp/a.png" -i "$tmp/b.png" \
          -lavfi "[0:v]scale=$w:$h,format=gray[a];[1:v]format=gray[b];[a][b]psnr" \
          -f null - 2>&1 | grep -oE 'average:[0-9.]+' | head -1 | cut -d: -f2) || p=0
    # `if`, not `awk ... && best=$p`: a false `a && b` is fatal under set -e.
    if awk -v a="${p:-0}" -v b="$best" 'BEGIN{exit !(a>b)}'; then best=$p; fi
  done
  rm -rf "$tmp"; printf '%s' "${best:-0}"
}

do_deliver(){
  # The box cannot reach the server; the server pulls $OUT itself, verifies it
  # and publishes it. Leaving $OUT in place is the whole contract.
  [ "$BOX" = 1 ] && { say "box mode: leaving $OUT for the server to collect"; return 0; }
  # Sources may already live in the archive (the whole library was moved there
  # up front, so Jellyfin shows only finished upscales). In that case the
  # destination is the matching path back in the library, and there is nothing
  # left to archive afterwards.
  local dest pre_archived=0
  case "$SRC_REMOTE" in
    "$ARCHIVE"/*) pre_archived=1
                  dest="${1:-$LIB/$(dirname "${SRC_REMOTE#"$ARCHIVE"/}")}" ;;
    *)            dest="${1:-$(dirname "$SRC_REMOTE")}" ;;
  esac
  [ -f "$OUT" ] || die "nothing to deliver; run process first"

  # Verify BEFORE the upload, not after: the link is ~2.2 MB/s, so a wrong
  # episode caught here costs seconds instead of half an hour of transfer, and
  # nothing wrong ever reaches the library path at all.
  [ -f "$LOCAL" ] || die "source gone from $W; cannot verify identity - re-run fetch"
  local ident
  ident=$(ident_psnr "$OUT" "$LOCAL") || ident=0
  if awk -v x="${ident:-0}" -v m="$IDENT_MIN_DB" 'BEGIN{exit !(x>=m)}'; then
    say "identity ok: ${ident} dB (floor ${IDENT_MIN_DB})"
  else
    die "IDENTITY CHECK FAILED for $BASE: best ${ident} dB < ${IDENT_MIN_DB} dB. Refusing to deliver - this output does not match its source."
  fi

  phase_set delivering 0 "$(stat -c%s "$OUT" 2>/dev/null || echo 0)" bytes
  say "delivering $BASE.mkv -> $dest"
  # Upload to a hidden temp name and rename only after the size is verified, so
  # Jellyfin and Sonarr never see a half-written episode.
  local tmp=".$BASE.mkv.part"
  retry ssh "$REMOTE" "mkdir -p $(printf '%q' "$dest")" || die "cannot reach server"
  retry rsync -q --partial "$OUT" "$REMOTE:$dest/$tmp" || die "delivery failed"
  local lsz rsz
  lsz=$(stat -c%s "$OUT")
  rsz=$(retry ssh "$REMOTE" "stat -c%s $(printf '%q' "$dest/$tmp")") || die "delivered file not found"
  [ "$lsz" = "$rsz" ] || die "delivered size $rsz != local $lsz"
  # ARCHIVE BEFORE PUBLISHING.
  #
  # When sources are .mkv (SRC_EXT=mkv), the delivered path IS the source path:
  # "$dest/$BASE.mkv" is the very file this episode was fetched from. Publishing
  # first would overwrite the original and then archive the upscale on top of it
  # - original gone, archive holding a copy of the output, and every later run
  # comparing the result against itself. With .avi sources the two paths always
  # differed, which is why this order was safe for years and is not any more.
  if [ "$pre_archived" = 1 ]; then
    say "original already archived, leaving in place"
  else
    local rel="${SRC_REMOTE#"$LIB"/}"
    retry ssh "$REMOTE" "mkdir -p $(printf '%q' "$ARCHIVE/$(dirname "$rel")") && \
                   mv -n $(printf '%q' "$SRC_REMOTE") $(printf '%q' "$ARCHIVE/$rel")" \
      || die "could not archive the original - refusing to publish over it"
    say "archived original -> $ARCHIVE/$rel"
  fi

  retry ssh "$REMOTE" "mv -f $(printf '%q' "$dest/$tmp") $(printf '%q' "$dest/$BASE.mkv")" \
    || die "could not publish $BASE.mkv"
  phase_set idle 0 0
  rm -rf "$W"
}

case "$PHASE" in
  fetch)   do_fetch ;;
  process) do_process ;;
  deliver) do_deliver "${2:-}" ;;
  run)     do_fetch; do_process; do_deliver "${2:-}" ;;
  # Deliberately the same three phases as `run`. fetch and deliver are no-ops
  # here, so the shape of an episode is identical on every machine and the
  # collector still gets a "leaving ... for the server" line in its log.
  box)     do_fetch; do_process; do_deliver ;;
esac
