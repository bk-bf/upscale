#!/usr/bin/env bash
# upscale-ep-rental — the desktop's upscale-ep `process` phase, on the Vast.ai box.
#
#   upscale-ep-rental <local-src.avi> <out.mkv>
#
# Settings mirror ~/.local/bin/upscale-ep on the desktop so both halves of the
# season are identical: animejanai-suc x2, libx264 CRF 18 preset veryfast,
# original audio remuxed, dedup OFF.
#
# Differences from the desktop, and why:
#   * WORKERS=4, not 8. This box is capped at 9.6 CPUs by its cgroup quota
#     (cpu.cfs_quota_us=960000) even though nproc says 20. Measured here:
#     4->43.7 fps, 5->42.6, 6->21.9, 8->14.0 - past 5 workers CFS throttling
#     collapses throughput. The desktop's 8 is right for the desktop.
#   * Chunked with resume. Disk is 32 GB; 33.4k upscaled 1280x960 PNGs is ~58 GB,
#     so a whole episode cannot be held at once.
set -euo pipefail

IN="${1:?need source .avi}"; OUT="${2:?need output .mkv}"

MODEL=${MODEL:-animejanai-suc}
MODEL_DIR=${MODEL_DIR:-/root/bench/models_janai}
BIN=${BIN:-/root/bench/resrgan/realesrgan-ncnn-vulkan}
WORKERS=${WORKERS:-4}
CHUNK=${CHUNK:-2000}
SCALE=${SCALE:-2}
CRF=${CRF:-18}
PRESET=${PRESET:-veryfast}
# Decode with the verified-good static 7.0.2; encode with the system ffmpeg.
FFDEC=${FFDEC:-/root/bench/ffmpeg-7.0.2-amd64-static/ffmpeg}
[ -x "$FFDEC" ] || FFDEC=ffmpeg
FFDEC_REF=${FFDEC_REF:-ffmpeg}
W=${WORK:-/root/work}/$(basename "${IN%.*}")

say(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ printf 'upscale-ep-rental: %s\n' "$*" >&2; exit 1; }
pngs(){ find "$1" -maxdepth 1 -name '*.png' -type f 2>/dev/null | wc -l; }
vframes(){ ffprobe -v error -count_frames -select_streams v \
             -show_entries stream=nb_read_frames -of csv=p=0 "$1"; }

FRAMES="$W/frames"; UP="$W/up"; SEGDIR="$W/seg"

# ffmpeg 8.1.2 silently mis-decodes MPEG-4 ASP: byte-identical input, visibly
# corrupt output, CORRECT frame count. Counts never catch it; only content does.
verify_decoder(){
  local bad=0 n=0 t d
  [ "$(command -v "$FFDEC")" = "$(command -v "$FFDEC_REF")" ] && { say "only one decoder - cross-check skipped"; return 0; }
  for t in 10 40 70 300 900; do
    "$FFDEC"     -v error -ss "$t" -i "$IN" -frames:v 1 "$W/.d1.png" -y 2>/dev/null || continue
    "$FFDEC_REF" -v error -ss "$t" -i "$IN" -frames:v 1 "$W/.d2.png" -y 2>/dev/null || continue
    n=$((n+1))
    d=$("$FFDEC" -v error -i "$W/.d1.png" -i "$W/.d2.png" \
        -lavfi "blend=all_mode=difference,format=gray,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=-" \
        -f null - 2>/dev/null | grep -o '=[0-9.]*$' | tr -d '=' | head -1)
    awk -v x="${d:-0}" 'BEGIN{exit !(x>0.5)}' && { bad=$((bad+1)); say "decoder mismatch at ${t}s (mean diff ${d})"; }
  done
  rm -f "$W/.d1.png" "$W/.d2.png"
  [ "$n" -gt 0 ] || { say "decoder cross-check inconclusive"; return 0; }
  [ "$bad" -eq 0 ] || die "DECODER DISAGREEMENT on $bad/$n frames - refusing to upscale corrupt input."
  say "decoder cross-check passed ($n frames)"
}

[ -f "$OUT" ] && { say "already processed: $(basename "$OUT")"; exit 0; }
[ -x "$BIN" ] || die "upscaler missing: $BIN"
[ -f "$MODEL_DIR/$MODEL.param" ] || die "model missing: $MODEL_DIR/$MODEL.param"
mkdir -p "$FRAMES" "$UP" "$SEGDIR"

FPS=$(ffprobe -v error -select_streams v -show_entries stream=r_frame_rate -of csv=p=0 "$IN")
TOTAL=$(vframes "$IN")
say "$(basename "$IN"): $TOTAL frames @ $FPS, $MODEL x$SCALE, $WORKERS workers, x264 crf$CRF $PRESET"
verify_decoder

t0=$(date +%s)
# Resume: only re-extract if the frame set is incomplete.
if [ "$(pngs "$FRAMES")" != "$TOTAL" ]; then
  rm -f "$FRAMES"/*.png
  "$FFDEC" -v error -nostdin -i "$IN" -fps_mode passthrough "$FRAMES/%06d.png" -y
  got=$(pngs "$FRAMES"); [ "$got" = "$TOTAL" ] || die "extracted $got of $TOTAL frames"
  say "extracted $got frames ($(du -sh "$FRAMES" | cut -f1))"
else
  say "frames already extracted, reusing"
fi

mapfile -t ALL < <(find "$FRAMES" -maxdepth 1 -name '*.png' -type f | sort)
[ "${#ALL[@]}" = "$TOTAL" ] || die "listed ${#ALL[@]} files, expected $TOTAL"

i=0; idx=0; enc_pid=""
NCHUNK=$(( (TOTAL + CHUNK - 1) / CHUNK ))
while [ "$i" -lt "$TOTAL" ]; do
  idx=$((idx+1))
  seg=$(printf '%s/seg_%04d.mkv' "$SEGDIR" "$idx")
  n=$CHUNK; [ $((i+n)) -gt "$TOTAL" ] && n=$((TOTAL-i))

  # Resume: a segment that already exists with the right frame count is done.
  if [ -f "$seg" ] && [ "$(vframes "$seg" 2>/dev/null)" = "$n" ]; then
    say "chunk $idx/$NCHUNK complete, skipping"; i=$((i+n)); continue
  fi
  rm -f "$seg"

  rm -rf "$W/shard"; mkdir -p "$W/shard"
  for ((k=i; k<i+n; k++)); do
    d="$W/shard/$(( (k-i) % WORKERS ))"; mkdir -p "$d"; ln -f "${ALL[$k]}" "$d/"
  done
  staged=0; for ((p=0; p<WORKERS; p++)); do staged=$((staged + $(pngs "$W/shard/$p"))); done
  [ "$staged" = "$n" ] || die "chunk $idx staged $staged of $n"

  a=$(date +%s)
  mkdir -p "$UP"
  wpids=()
  for ((p=0; p<WORKERS; p++)); do
    "$BIN" -i "$W/shard/$p" -o "$UP" -m "$MODEL_DIR" -n "$MODEL" -s "$SCALE" -f png \
      >/dev/null 2>>"$W/upscale.err" &
    wpids+=($!)
  done
  for wp in "${wpids[@]}"; do wait "$wp" || die "an upscale worker failed"; done
  b=$(date +%s)
  got=$(pngs "$UP"); [ "$got" = "$n" ] || die "chunk $idx upscaled $got of $n"

  # Hand off by rename and encode in the background so the GPU starts the next
  # chunk immediately. Wait on the PREVIOUS encode specifically (never a bare
  # `wait`, which would reap it and break the later wait).
  encdir="$W/enc_$idx"; rm -rf "$encdir"; mv "$UP" "$encdir"; mkdir -p "$UP"
  [ -n "$enc_pid" ] && { wait "$enc_pid" || die "background encode failed"; }
  (
    ffmpeg -v error -nostdin -framerate "$FPS" -pattern_type glob -i "$encdir/*.png" \
           -c:v libx264 -crf "$CRF" -preset "$PRESET" -pix_fmt yuv420p "$seg" -y || exit 1
    e=$(vframes "$seg"); [ "$e" = "$n" ] || { echo "chunk $idx: encoded $e of $n" >&2; exit 1; }
    rm -rf "$encdir"
  ) &
  enc_pid=$!

  say "chunk $idx/$NCHUNK upscaled $n in $((b-a))s ($(echo "scale=1;$n/($b-$a)"|bc) fps)  $((i+n))/$TOTAL  free $(df -h / | awk 'NR==2{print $4}')"
  i=$((i+n))
done
[ -n "$enc_pid" ] && { wait "$enc_pid" || die "final background encode failed"; }

# ' inside a quoted concat path must be written '\'' — episode titles like
# "A Shinigami's Work" otherwise truncate the filename.
find "$SEGDIR" -name 'seg_*.mkv' | sort |
  sed -e "s/'/'\\\\''/g" -e "s|^|file '|" -e "s|$|'|" > "$SEGDIR/list"
# Video is rebuilt from frames and carries no audio; remux the original.
ffmpeg -v error -nostdin -f concat -safe 0 -i "$SEGDIR/list" -i "$IN" \
       -map 0:v:0 -map "1:a?" -c copy -f matroska "$OUT.part" -y
final=$(vframes "$OUT.part")
[ "$final" = "$TOTAL" ] || die "FINAL MISMATCH: $final frames, source had $TOTAL"
mv "$OUT.part" "$OUT"
t2=$(date +%s)
say "done: $OUT  $(du -h "$OUT" | cut -f1)  $final frames  wall $((t2-t0))s ($(echo "scale=1;($t2-$t0)/60"|bc) min)"
rm -rf "$FRAMES" "$UP" "$W/shard" "$SEGDIR"
