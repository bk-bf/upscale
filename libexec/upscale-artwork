#!/usr/bin/env bash
# upscale-artwork — give newly delivered episodes a real thumbnail.
#
#   upscale-artwork              every episode that does not yet have ours
#   upscale-artwork S02E19 ...   only these
#   upscale-artwork --retry-missing   also re-try ones a provider had no image for
#   upscale-artwork --dry-run    say what would change, change nothing
#
# WHY THIS EXISTS
#
# Jellyfin's local "Screen Grabber" extracts the episode thumbnail from the video
# itself, at a position hardcoded to roughly 10% of the runtime - there is no
# setting for it in 10.11. On a 350-episode show that lands on the opening titles
# again and again, so half the library ends up with the same dark, hardsubbed,
# indistinguishable frame.
#
# The fix is to take the episode still from TheTVDB instead. Doing that for the
# whole library would mean disabling Screen Grabber for ALL shows, and screen
# grabs are genuinely better for short series where every frame is distinctive -
# so this works per episode, on the series we are actually upscaling, and leaves
# the library settings alone.
#
# It runs after delivery because a freshly delivered episode is exactly the one
# that just got a bad thumbnail.
#
# NOT TMDB: TMDB's top-voted still for Bleach episodes is the black-and-white
# "BLEACH" title card - the precise thing being complained about. TheTVDB serves
# one canonical screencap per episode.
set -uo pipefail

STATE=${STATE:-$HOME/.upscale-queue}
LOG="$STATE/artwork.log"
DONE="$STATE/artwork.done"          # itemid<TAB>imagetag  (or 'none')
SERIES=${ARTWORK_SERIES:-Bleach}
PROVIDER=${ARTWORK_PROVIDER:-TheTVDB}
JF_URL=${JF_URL:-https://jellyfin.callmedaddy.dedyn.io}
# The key is read from jellyseerr's settings at run time rather than copied into
# a file of our own: one fewer place for a secret to live and go stale.
JF_KEYFILE=${JF_KEYFILE:-/home/ubuntu/server/mediaserver/config/jellyseerr/settings.json}
mkdir -p "$STATE"; touch "$DONE"

say(){ printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
[ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 262144 ] && \
  { tail -300 "$LOG" > "$LOG.t" && mv -f "$LOG.t" "$LOG"; }

dry=0; retry_missing=0; adopt=0; want=()
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;;
    # Record whatever each episode has RIGHT NOW as ours, downloading nothing.
    # Used once, to adopt images that were already set correctly by hand - the
    # alternative is re-downloading dozens of identical files to learn a fact we
    # already know.
    --adopt) adopt=1 ;;
    --retry-missing) retry_missing=1 ;;
    -*) printf 'upscale-artwork: unknown option %s\n' "$a" >&2; exit 2 ;;
    *) want+=("$a") ;;
  esac
done

JF_KEY=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['jellyfin']['apiKey'])" "$JF_KEYFILE" 2>/dev/null) || JF_KEY=''
if [ -z "$JF_KEY" ]; then say "no Jellyfin API key available - nothing done"; exit 1; fi

jf(){ curl -s --max-time 30 -H "X-Emby-Token: $JF_KEY" "$@"; }

sid=$(jf "$JF_URL/Items?Recursive=true&IncludeItemTypes=Series&SearchTerm=$SERIES" |
      python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
print(next((i['Id'] for i in d.get('Items',[]) if i.get('Name')=='$SERIES'),''))" 2>/dev/null) || sid=''
if [ -z "$sid" ]; then say "series '$SERIES' not found in Jellyfin - nothing done"; exit 1; fi

# id, SxxEyy, current primary tag, and whether the provider knows this episode
mapfile -t EPS < <(jf "$JF_URL/Shows/$sid/Episodes?fields=ProviderIds,ImageTags" |
  python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for i in d.get('Items',[]):
    se='S%02dE%02d'%(i.get('ParentIndexNumber') or 0, i.get('IndexNumber') or 0)
    tag=(i.get('ImageTags') or {}).get('Primary','')
    tvdb=(i.get('ProviderIds') or {}).get('Tvdb','')
    print('\t'.join([i['Id'],se,tag,tvdb]))" 2>/dev/null)

if [ "${#EPS[@]}" -eq 0 ]; then say "no episodes returned for '$SERIES'"; exit 1; fi

done_n=0; skip_n=0; miss_n=0; fail_n=0
for row in "${EPS[@]}"; do
  IFS=$'\t' read -r id se tag tvdb <<< "$row"
  [ -n "$id" ] || continue

  # only the episodes asked for, when any were named
  if [ "${#want[@]}" -gt 0 ]; then
    hit=0; for w in "${want[@]}"; do
      case "$se" in *"$(printf '%s' "$w" | tr 'a-z' 'A-Z')"*) hit=1 ;; esac
    done
    [ "$hit" = 1 ] || continue
  fi

  if [ "${adopt:-0}" = 1 ]; then
    if [ -n "$tag" ]; then
      grep -vF "$id"$'\t' "$DONE" > "$DONE.t" 2>/dev/null || true
      printf '%s\t%s\n' "$id" "$tag" >> "$DONE.t"; mv -f "$DONE.t" "$DONE"
      done_n=$((done_n+1))
    else
      miss_n=$((miss_n+1))
    fi
    continue
  fi

  prev=$(grep -m1 -F "$id"$'\t' "$DONE" 2>/dev/null | cut -f2) || prev=''
  # Already ours AND still ours: the recorded tag still matches what Jellyfin
  # serves. If it does not, something re-extracted it and we redo - which is
  # what makes this safe to run on a timer for ever.
  if [ -n "$prev" ] && [ "$prev" = "$tag" ]; then skip_n=$((skip_n+1)); continue; fi
  if [ "$prev" = none ] && [ "$retry_missing" = 0 ]; then skip_n=$((skip_n+1)); continue; fi

  if [ -z "$tvdb" ]; then
    # No provider id: nothing to fetch. Recorded so it is not retried every run.
    grep -qF "$id"$'\t' "$DONE" || printf '%s\tnone\n' "$id" >> "$DONE"
    miss_n=$((miss_n+1)); continue
  fi

  url=$(jf "$JF_URL/Items/$id/RemoteImages?type=Primary&providerName=$PROVIDER&limit=1" |
    python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
imgs=d.get('Images') or []
print(imgs[0]['Url'] if imgs else '')" 2>/dev/null) || url=''
  if [ -z "$url" ]; then
    grep -qF "$id"$'\t' "$DONE" || printf '%s\tnone\n' "$id" >> "$DONE"
    say "$se: $PROVIDER has no primary image"; miss_n=$((miss_n+1)); continue
  fi

  if [ "$dry" = 1 ]; then say "$se: would download from $PROVIDER"; done_n=$((done_n+1)); continue; fi

  enc=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=''))" "$url")
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 60 -X POST \
          -H "X-Emby-Token: $JF_KEY" \
          "$JF_URL/Items/$id/RemoteImages/Download?Type=Primary&ImageUrl=$enc") || code=000
  if [ "$code" = 204 ] || [ "$code" = 200 ]; then
    newtag=$(jf "$JF_URL/Items/$id?fields=ImageTags" |
      python3 -c "
import json,sys
try: print((json.load(sys.stdin).get('ImageTags') or {}).get('Primary',''))
except Exception: print('')" 2>/dev/null) || newtag=''
    # record by replacing any prior line for this item
    grep -vF "$id"$'\t' "$DONE" > "$DONE.t" 2>/dev/null || true
    printf '%s\t%s\n' "$id" "${newtag:-unknown}" >> "$DONE.t"
    mv -f "$DONE.t" "$DONE"
    say "$se: primary image set from $PROVIDER"; done_n=$((done_n+1))
  else
    say "$se: download failed (http $code)"; fail_n=$((fail_n+1))
  fi
done

say "run: $done_n set, $skip_n already ours, $miss_n without a provider image, $fail_n failed"
printf '%s set, %s already ours, %s no provider image, %s failed\n' "$done_n" "$skip_n" "$miss_n" "$fail_n"
[ "$fail_n" -eq 0 ]
