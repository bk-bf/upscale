#!/usr/bin/env bash
# upscale — send every file in a source directory to a GPU, scale it, write the
# result to a target directory.
#
#   upscale --source DIR --target DIR --device SPEC [--device SPEC ...]
#           [--size N] [--archive DIR | --delete] [--workers N] [--scratch DIR]
#
# The whole design is one sentence: a source is a file in the source directory.
# Take it, upscale it, write the result to the target directory, then move or
# delete the original so it stops being a source.
#
# The previous version kept sources and results in one tree and spent most of
# itself undoing that. It needed SRC_EXT to guess which files were sources; an
# archive lookup to tell a delivered master from its own source; ranges,
# parities and absolute episode numbers to select a subset; .upscaleignore to
# re-exclude what those wrongly included; and a picture-content identity check
# because the transfer renamed every file to src.avi, so a returned result could
# not be matched back by name. Each of those grew its own failures - re-upscaling
# its own output, archiving a master as an "original", rejecting correct results
# at 19.6 dB against a 20 dB threshold, two collectors swapping src.avi under
# each other's running decoder.
#
# None of them are decisions this program has to make any more:
#   * what is a source      -> what is in --source
#   * is this file finished -> it is in --target, or it is not
#   * which file is this    -> it kept its name the entire way
#   * what should I skip    -> move it out of --source
#
# What is genuinely hard is kept: the upscale itself is chunked and resumable
# (libexec/upscale-worker), because an episode is tens of thousands of frames
# and a machine will be interrupted.
set -euo pipefail

STATE_DIR=${UPSCALE_STATE:-$HOME/.upscale}
RUN="$STATE_DIR/run"
WORKER=${WORKER:-.local/libexec/upscale-worker}   # path on the DEVICE, from $HOME


say(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*"; }
die(){ printf 'upscale: %s\n' "$*" >&2; exit 1; }

usage(){ cat >&2 <<'EOF'
usage: upscale [common options] --device NAME=SPEC [options] [--device ...]

  A device OWNS a source directory. Options written after a --device belong to
  that device; options written before the first one are defaults for all of
  them. Two devices may share a target, never a source.

    upscale --target /srv/done --archive /srv/originals --size 2 \
            --device "rental=-p 31174 root@1.2.3.4" --source /srv/lane-a \
            --device desktop --source /srv/lane-b --scratch /fast/scratch

  --device NAME=SPEC  an ssh destination; NAME is what appears in the log and
                      on the page. A bare destination is its own name.
  --source DIR   the files this device works through. Any extension.
  --target DIR   results are written here under the same filename.
  --archive DIR  move each source here once its result is written, or
  --delete       delete it. One of the two is required, so a finished file
                 stops being a source.
  --size N       scale factor (default 2).
  --workers N    upscaler processes on that device.
  --scratch DIR  working directory ON the device (~40 GB per file).
  --model NAME   model name, passed through to the worker.

  Which device does an episode? The one whose source directory holds it.
  Reassigning is moving the file to the other directory; there is nothing else
  to set. A .upscaleignore in a source directory excludes files by glob.
EOF
exit 2; }

# A device may be written NAME=SPEC. The name is a label only - it never
# decides anything - but it travels with the command, so nothing has to keep a
# registry to know that "rental" and "-p 31174 root@1.2.3.4" are the same box.
dev_name(){ case "$1" in [A-Za-z0-9_.-]*=*) printf '%s' "${1%%=*}" ;; *) printf '%s' "$1" ;; esac; }
dev_spec(){ case "$1" in [A-Za-z0-9_.-]*=*) printf '%s' "${1#*=}" ;; *) printf '%s' "$1" ;; esac; }

# Defaults live until the first --device; after that, an option belongs to the
# device it follows. This is the only place the two are distinguished.
d_source='' d_target='' d_archive='' d_delete=0
d_workers='' d_scratch='' d_model='' d_size=2
n=0
names=() specs=() srcs=() tgts=() arcs=() dels=() wkss=() scrs=() mdls=() szs=()

set_opt(){        # $1 = array name, $2 = default var name, $3 = value
  if [ "$n" -eq 0 ]; then printf -v "$2" '%s' "$3"
  else eval "$1[\$((n-1))]=\$3"; fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --device)
      n=$((n+1))
      names+=("$(dev_name "${2:?}")"); specs+=("$(dev_spec "${2:?}")")
      srcs+=("$d_source"); tgts+=("$d_target"); arcs+=("$d_archive")
      dels+=("$d_delete"); wkss+=("$d_workers"); scrs+=("$d_scratch")
      mdls+=("$d_model"); szs+=("$d_size")
      shift 2 ;;
    --source)  set_opt srcs d_source  "${2:?}"; shift 2 ;;
    --target)  set_opt tgts d_target  "${2:?}"; shift 2 ;;
    --archive) set_opt arcs d_archive "${2:?}"; shift 2 ;;
    --delete)  set_opt dels d_delete  1;        shift ;;
    --workers) set_opt wkss d_workers "${2:?}"; shift 2 ;;
    --scratch) set_opt scrs d_scratch "${2:?}"; shift 2 ;;
    --model)   set_opt mdls d_model   "${2:?}"; shift 2 ;;
    --size)    set_opt szs  d_size    "${2:?}"; shift 2 ;;
    -h|--help) usage ;;
    *) die "unknown option: $1  (--help)" ;;
  esac
done

[ "$n" -gt 0 ] || usage

for i in $(seq 0 $((n-1))); do
  nm=${names[$i]}
  [ -n "${srcs[$i]}" ] || die "$nm has no --source"
  [ -n "${tgts[$i]}" ] || die "$nm has no --target"
  [ -d "${srcs[$i]}" ] || die "$nm: no such source directory: ${srcs[$i]}"
  [ "${dels[$i]}" = 1 ] && [ -n "${arcs[$i]}" ] && die "$nm: --archive and --delete are exclusive"
  [ "${dels[$i]}" = 0 ] && [ -z "${arcs[$i]}" ] && \
    die "$nm: needs --archive DIR or --delete, so a finished file stops being a source"
  mkdir -p "${tgts[$i]}" || die "$nm: cannot create target: ${tgts[$i]}"
  [ -n "${arcs[$i]}" ] && { mkdir -p "${arcs[$i]}" || die "$nm: cannot create archive: ${arcs[$i]}"; }
  # TWO DEVICES MAY NOT SHARE A SOURCE. That is what makes assignment a fact
  # rather than a race: the directory a file sits in names the machine that
  # will do it, and nothing has to claim anything.
  for j in $(seq 0 $((i-1))); do
    [ "$(readlink -f "${srcs[$i]}")" = "$(readlink -f "${srcs[$j]}")" ] && \
      die "${names[$j]} and $nm share a source directory - give each its own"
  done
done

mkdir -p "$RUN"
STOP="$RUN/stop"; rm -f "$STOP"

# ---------------------------------------------------------------- sources ---
ignored(){        # $1 = filename, $2 = source dir
  local f=$1 dir=$2 pat
  [ -f "$dir/.upscaleignore" ] || return 1
  while IFS= read -r pat || [ -n "$pat" ]; do
    case "$pat" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2254
    case "$f" in $pat) return 0 ;; esac
  done < "$dir/.upscaleignore"
  return 1
}

# No extension test. What makes a file a source is where it is.
sources(){        # $1 = source dir
  local p b
  for p in "$1"/*; do
    [ -f "$p" ] || continue
    b=${p##*/}
    case "$b" in .*) continue ;; esac
    ignored "$b" "$1" || printf '%s\n' "$b"
  done
}

key(){ printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }
# No claiming. A device owns its source directory, so the only file two
# devices could both pick is one that is in two directories at once, which it
# cannot be. Reassigning an episode is moving it; there is nothing to release.
next_source(){    # $1 = source dir, $2 = target dir
  local b
  while IFS= read -r b; do
    [ -e "$2/$b" ] || { printf '%s\n' "$b"; return 0; }
  done < <(sources "$1" | sort)
  return 1
}

# --------------------------------------------------------------- transfer ---
# One implementation, and the server owns both ends. A device never reaches back
# here: it has no route home and holds no key to this machine.
# stderr is discarded on purpose: a rented box prints a login banner on every
# single ssh, which buried the actual progress lines. What went wrong is carried
# by the exit status and reported by the caller; what the worker has to say is
# in the device's own log.
rsh(){ local d=$1; shift; # shellcheck disable=SC2086
       ssh -o BatchMode=yes -o ControlPath=none -o ConnectTimeout=20 $d "$@" 2>/dev/null; }
# Transfers report progress. A push of ~200 MB over a ~2 MB/s link is minutes,
# and a phase that shows no percentage, rate or ETA is indistinguishable from
# one that is stuck - which is the whole reason to be watching.
#
# rsync writes progress with carriage returns; \r becomes \n so the last line
# is always the newest sample, and the file is read by the snapshot rather than
# parsed here.
xfer(){        # $1 = state dir, then the rsync arguments
  local st=$1; shift
  rsync --info=progress2 --partial "$@" 2>&1 | tr '\r' '\n' > "$st/xfer"
}
push(){ xfer "$4" -e "ssh -o BatchMode=yes -o ControlPath=none $1" "$2" ":$3"; }
pull(){ xfer "$4" -e "ssh -o BatchMode=yes -o ControlPath=none $1" ":$2" "$3"; }

frames(){ ffprobe -v error -select_streams v:0 -count_packets \
            -show_entries stream=nb_read_packets -of csv=p=0 "$1" 2>/dev/null; }

# ------------------------------------------------------------------- work ---
run_one(){        # $1 lane index, $2 filename
  local i=$1 name=$2 dev nm src tgt arc del wk scr mdl siz st rwork out want got
  nm=${names[$i]}; dev=${specs[$i]}
  src=${srcs[$i]}; tgt=${tgts[$i]}; arc=${arcs[$i]}; del=${dels[$i]}
  wk=${wkss[$i]}; scr=${scrs[$i]}; mdl=${mdls[$i]}; siz=${szs[$i]}
  st="$RUN/$(key "$nm")"; mkdir -p "$st"
  rwork=$(rsh "$dev" 'printf %s "${UPSCALE_WORK:-$HOME/upscale-work}"' | tr -d '\r') || rwork=
  [ -n "$rwork" ] || { say "[$nm] unreachable"; return 1; }
  printf '%s' "$name" > "$st/file"
  phase(){ printf '%s' "$1" > "$st/phase"; : > "$st/xfer"; }

  # The name travels with the file. That is the whole reason this program does
  # not need to recognise a result from its pixels: nothing ever renamed it, so
  # what comes back from out-<name> is <name>.
  rsh "$dev" "mkdir -p $(printf %q "$rwork")" >/dev/null || return 1

  # ONE FILE PER DEVICE. The worker is started detached, so it outlives the ssh
  # that launched it and outlives this program: a driver killed mid-episode
  # leaves it running. Starting anything here while that is true puts two
  # workers on one GPU - which does not fail, it just halves the rate with
  # nothing reporting a fault. It happened: 16 upscaler processes where there
  # should have been 8.
  #
  # So wait for the device to be free, whatever it is working on. Its work is
  # not lost: the chunks are on its disk and whoever claims that file next
  # resumes from them.
  if rsh "$dev" "pgrep -f '[u]pscale-worker process' >/dev/null 2>&1"; then
    phase waiting
    say "[$nm] device is busy with work from an earlier run - waiting for it"
    rsh "$dev" "while pgrep -f '[u]pscale-worker process' >/dev/null 2>&1; do sleep 15; done" || true
    say "[$nm] device free"
  fi

  if ! rsh "$dev" "test -s $(printf %q "$rwork/out-$name")" 2>/dev/null; then
    phase sending; say "[$nm] $name: sending"
    push "$dev" "$src/$name" "$rwork/$name" "$st" || { say "[$nm] $name: send failed"; return 1; }
    phase upscaling; say "[$nm] $name: upscaling"
    # shellcheck disable=SC2086
    rsh "$dev" "cd $(printf %q "$rwork") && setsid nohup env \
          ${wk:+WORKERS=$wk} ${scr:+WORK=$(printf %q "$scr")} \
          ${mdl:+MODEL=$mdl} SCALE=$siz \
          \$HOME/$WORKER process $(printf %q "$rwork/$name") $(printf %q "$rwork/out-$name") \
          < /dev/null >> $(printf %q "$rwork/log") 2>&1" \
      || { say "[$nm] $name: upscale failed (see $rwork/log on the device)"; return 1; }
  else
    say "[$nm] $name: result already on the device, collecting"
  fi

  phase retrieving; say "[$nm] $name: retrieving"
  out="$tgt/.$name.part"
  pull "$dev" "$rwork/out-$name" "$out" "$st" || { say "[$nm] $name: retrieve failed"; return 1; }

  # The only check worth making. A truncated transfer is what actually goes
  # wrong, and frame count catches it exactly. WHICH episode this is was never
  # in question.
  want=$(frames "$src/$name"); got=$(frames "$out")
  if [ -z "$got" ] || [ "$want" != "$got" ]; then
    say "[$nm] $name: $got frames, source has $want - left as .part, not published"
    return 1
  fi

  mv -f "$out" "$tgt/$name"
  rsh "$dev" "rm -f $(printf %q "$rwork/$name") $(printf %q "$rwork/out-$name")" >/dev/null 2>&1 || true
  if [ "$del" = 1 ]; then rm -f "$src/$name"; say "[$nm] $name: done, source deleted"
  else mv -f "$src/$name" "$arc/$name"; say "[$nm] $name: done, source archived"; fi
  rm -f "$st/file" "$st/phase" "$st/xfer"
}

# "What is left" is read from the source directory every time, so files added
# while this runs are simply picked up.
device_loop(){    # $1 = lane index
  local i=$1 nm=${names[$1]} name
  while [ ! -f "$STOP" ]; do
    name=$(next_source "${srcs[$i]}" "${tgts[$i]}") || { say "[$nm] nothing left"; return 0; }
    run_one "$i" "$name" || say "[$nm] $name: left in place for a later run"
  done
  say "[$nm] stopped"
}

# A snapshot for whatever wants to watch: the web UI reads this rather than
# being told, so there is no second place that decides what is running.
snapshot(){
  local i f ph nm sp xf first=1
  { printf '{"devices":['
    for i in $(seq 0 $((n-1))); do
      nm=${names[$i]}; sp=${specs[$i]}
      f=$(cat "$RUN/$(key "$nm")/file" 2>/dev/null || true)
      # The DRIVER's phase, not the worker's. The worker only knows the GPU
      # part; sending and retrieving are this program's doing, and a worker
      # asked mid-push still reports whatever it last did.
      ph=$(cat "$RUN/$(key "$nm")/phase" 2>/dev/null || true)
      # last non-empty progress sample: "  123,456,789  45%  1.85MB/s  0:02:13"
      xf=$(grep -a '%' "$RUN/$(key "$nm")/xfer" 2>/dev/null | tail -1 | tr -s ' ' || true)
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"device":"%s","ssh":"%s","source":"%s","target":"%s","file":"%s","phase":"%s","xfer":"%s"}' \
             "$nm" "$sp" "${srcs[$i]}" "${tgts[$i]}" "$f" "$ph" \
             "$(printf '%s' "$xf" | tr -d '"')"
    done
    printf '],"ts":%s}' "$(date +%s)"
  } > "$RUN/state.json.tmp" && mv -f "$RUN/state.json.tmp" "$RUN/state.json"
}
watcher(){ while [ ! -f "$STOP" ]; do snapshot; sleep 5; done; snapshot; }

trap 'touch "$STOP"; say "stopping after the current file"' INT TERM

# The snapshot is only true while this process is alive. Left behind, it makes
# the page report a run that ended - the same shape of bug as an abandoned
# .part being read as a delivery in flight.
cleanup(){
  local d
  rm -f "$RUN/state.json"
  for d in "$RUN"/claim-*; do
    [ -d "$d" ] && [ "$(cat "$d/pid" 2>/dev/null)" = "$$" ] && rm -rf "$d"
  done
  return 0
}
trap cleanup EXIT

for i in $(seq 0 $((n-1))); do
  say "[${names[$i]}] $(sources "${srcs[$i]}" | wc -l) file(s)  ${srcs[$i]} -> ${tgts[$i]}  x${szs[$i]}"
done

watcher &
_watch=$!
for i in $(seq 0 $((n-1))); do device_loop "$i" & done
for i in $(seq 0 $((n-1))); do wait -n 2>/dev/null || true; done
touch "$STOP"; wait "$_watch" 2>/dev/null || true; rm -f "$STOP"
say "done"
