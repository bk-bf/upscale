#!/usr/bin/env bash
# upscale — keep upscaling episodes until nothing is left. Self-healing.
#
#   upscale run          process everything outstanding, then idle for more
#   upscale once         process outstanding work, then exit
#   upscale --status     live progress bar, rate, ETA and log tail (Ctrl-C to exit)
#                        piped/non-tty: prints once and exits
#   upscale --pause      finish the current chunk, then hold
#   upscale --resume     release a pause
#   upscale --stop       finish the current episode, then exit
#   upscale --list       show what is outstanding and stop
#
# Bare words work too (`upscale status`, `upscale pause`, ...).
#
# There is NO saved work list and no progress pointer, deliberately. The queue
# asks the server what is outstanding every cycle:
#
#     an episode needs work  <=>  its source .avi exists
#                                 AND the matching .mkv does not
#
# So a power cut, a desktop reboot or a server reboot needs no recovery step:
# whatever is unfinished is still unfinished, and whatever completed is visible
# as a .mkv and is skipped. Partly-done episodes resume mid-way too, because
# upscale-ep verifies and skips already-encoded chunks in /mnt/scratch.
#
# Ordering: sources already in the archive come first, sources still sitting in
# the library come last. That is how the already-watched episode 1 is kept
# visible in Jellyfin and processed at the very end.
#
# Transfers overlap compute across episodes - while episode N is on the GPU,
# N+1 is downloading and N-1 is uploading. The link is only ~2.2 MB/s, so this
# matters: overlapped it is free, serial it would add ~6 min per episode.
set -euo pipefail

REMOTE=${REMOTE:-ubuntu}
LIB=${LIB:-/mnt/media/tv/Bleach}
ARCHIVE=${ARCHIVE:-$LIB/.upscale-originals}
WORK=${WORK:-/mnt/scratch/upscale-ep}   # must match the worker's scratch dir
LIMIT=${LIMIT:-0}                 # 0 = no limit; used to bound test runs
IDLE=${IDLE:-300}                 # seconds to wait when there is no work
STATE=${STATE:-$HOME/.upscale-queue}
mkdir -p "$STATE"
QLOG="$STATE/log"
# The per-episode worker is a helper, deliberately NOT a second command on
# $PATH. Override WORKER to relocate it.
WORKER=${WORKER:-$(command -v upscale-worker 2>/dev/null || echo "${0%/*}/../libexec/upscale-worker")}; FAILED="$STATE/failed"; MAX_FAILS=${MAX_FAILS:-3}; PAUSE="$STATE/pause"; STOP="$STATE/stop"
say(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$QLOG" >&2; }

# Ask the server what is outstanding. Archived sources first, library sources
# last; both sorted, so the order is stable across restarts.
discover(){
  ssh "$REMOTE" "bash -s" <<REMOTE_EOF
set -euo pipefail
lib=$(printf '%q' "$LIB"); arc=$(printf '%q' "$ARCHIVE")
emit(){ # \$1 = source path, \$2 = directory the .mkv belongs in
  base=\$(basename "\${1%.*}")
  [ -f "\$2/\$base.mkv" ] || printf '%s\n' "\$1"
}
# archived sources -> output goes back to the matching library folder
if [ -d "\$arc" ]; then
  find "\$arc" -type f -name '*.avi' | sort | while read -r f; do
    rel=\${f#"\$arc"/}; emit "\$f" "\$lib/\$(dirname "\$rel")"
  done
fi
# sources still in the library -> output lands beside them
find "\$lib" -type f -name '*.avi' -not -path "\$lib/.*" | sort | while read -r f; do
  emit "\$f" "\$(dirname "\$f")"
done
REMOTE_EOF
}

# Progress is read from upscale-ep's job file plus a live count of the frames
# already upscaled in the current chunk, so the bar advances continuously
# rather than jumping once per chunk.
bar(){ local p=$1 w=${2:-34} f e i out=''
  f=$(( p * w / 100 )); [ "$f" -lt 0 ] && f=0; [ "$f" -gt "$w" ] && f=$w
  e=$(( w - f ))
  for ((i=0;i<f;i++)); do out+='█'; done
  for ((i=0;i<e;i++)); do out+='░'; done
  printf '[%s]' "$out"
}

# Host utilisation. Everything here is a local /proc or /sys read - a few
# hundred microseconds per frame - so it is safe to sample every second.
# Rate metrics (cpu, net) need two samples, so the first frame shows "-".
_p_tot=0; _p_idle=0; _p_rx=0; _p_tx=0; _p_t=0
NETIF=${NETIF:-$(ip route show default 2>/dev/null | awk '{print $5; exit}')}
GPUBUSY=$(ls /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1)
GPUDIR=${GPUBUSY%/gpu_busy_percent}

resources(){
  local tot idle dt didle cpu='-' ram gpu='-' vram='' rx tx now drx='' dtx=''
  read -r _ a b c d e f g h _ < /proc/stat
  tot=$((a+b+c+d+e+f+g+h)); idle=$((d+e))
  if [ "$_p_tot" -gt 0 ]; then
    dt=$((tot-_p_tot)); didle=$((idle-_p_idle))
    [ "$dt" -gt 0 ] && cpu=$(( (dt-didle)*100/dt ))
  fi
  _p_tot=$tot; _p_idle=$idle

  ram=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f/%.1fG", (t-a)/1048576, t/1048576}' /proc/meminfo)
  [ -n "$GPUBUSY" ] && [ -r "$GPUBUSY" ] && gpu=$(cat "$GPUBUSY" 2>/dev/null)
  if [ -r "$GPUDIR/mem_info_vram_used" ]; then
    vram=$(awk -v u="$(cat "$GPUDIR/mem_info_vram_used")" -v t="$(cat "$GPUDIR/mem_info_vram_total")" \
      'BEGIN{printf "  vram %.1f/%.1fG", u/1073741824, t/1073741824}')
  fi

  now=$(date +%s%N)
  if [ -n "$NETIF" ] && [ -r "/sys/class/net/$NETIF/statistics/rx_bytes" ]; then
    rx=$(cat "/sys/class/net/$NETIF/statistics/rx_bytes")
    tx=$(cat "/sys/class/net/$NETIF/statistics/tx_bytes")
    if [ "$_p_t" -gt 0 ]; then
      drx=$(awk -v x="$((rx-_p_rx))" -v s="$(( (now-_p_t)/1000000 ))" 'BEGIN{printf "%.1f", (s>0)?x*8/s/1000:0}')
      dtx=$(awk -v x="$((tx-_p_tx))" -v s="$(( (now-_p_t)/1000000 ))" 'BEGIN{printf "%.1f", (s>0)?x*8/s/1000:0}')
    fi
    _p_rx=$rx; _p_tx=$tx; _p_t=$now
  fi
  printf 'cpu %3s%%   ram %s   gpu %3s%%%s   net %s v %s ^ Mbit/s\033[K\n' \
    "$cpu" "$ram" "$gpu" "$vram" "${drx:--}" "${dtx:--}"
}

# Size of any in-flight upload. rsync --partial writes .NAME.mkv.part.XXXXXX
# with a random suffix while transferring, hence the trailing glob. Polled on the
# slow schedule as discover, never per frame.
upload_size(){
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$REMOTE" \
    "find $(printf '%q' "$LIB") -name '.*.mkv.part*' -printf '%s\n' 2>/dev/null | head -1" 2>/dev/null
}

render(){
  local n=${OUTSTANDING:-?} JOB="$STATE/job"

  # What is the pipeline actually doing? Processing is only one of four states;
  # reporting "idle" while a 400 MB upload is in flight is what this fixes.
  local act="" ep="" pid_up pid_dl pid_proc
  pgrep -f 'realesrgan-ncnn-vulkan|"$WORKER" process|upscale _process' >/dev/null 2>&1 && act=processing
  if pgrep -f '[r]sync .*mkv' >/dev/null 2>&1; then
    [ -n "$act" ] && act="$act + uploading" || act=uploading
  elif pgrep -f '[r]sync .*avi' >/dev/null 2>&1; then
    [ -n "$act" ] && act="$act + fetching" || act=fetching
  fi
  [ -z "$act" ] && { pgrep -f '[u]pscale run|[u]pscale once' >/dev/null 2>&1 && act="waiting for work" || act="not running"; }

  if [ -f "$JOB" ]; then
    # shellcheck disable=SC1090
    . "$JOB"
    local segs=0 inflight=0 df pct chunks el fps eta ph
    [ -d "$SEGDIR" ] && segs=$(find "$SEGDIR" -name 'seg_*.mkv' 2>/dev/null | wc -l)
    local up="${UPDIR:-$WORK/$(basename "${SRC%.*}")/up}"
    [ -d "$up" ] && inflight=$(find "$up" -maxdepth 1 -name '*.png' -type f 2>/dev/null | wc -l)
    [ "$inflight" -ge "$CHUNK" ] && inflight=0
    df=$(( segs * CHUNK + inflight )); [ "$df" -gt "$TOTAL" ] && df=$TOTAL
    [ "${_hw_src:-}" = "$SRC" ] || { _hw_src="$SRC"; _hw=0; }
    [ "$df" -lt "${_hw:-0}" ] && df=$_hw || _hw=$df
    chunks=$(( (TOTAL + CHUNK - 1) / CHUNK )); pct=$(( TOTAL ? df*100/TOTAL : 0 ))
    printf '\033[1m%s\033[0m\033[K\n' "$(basename "${SRC%.*}")"
    printf '%s %3d%%   %s/%s frames\033[K\n' "$(bar "$pct")" "$pct" "$df" "$TOTAL"
    el=$(( $(date +%s) - $(cat "$STATE/started" 2>/dev/null || date +%s) ))
    fps=$(awk -v f="$df" -v e="$el" 'BEGIN{printf "%.1f", (e>0)?f/e:0}')
    eta=$(awk -v r="$((TOTAL-df))" -v v="$fps" 'BEGIN{printf "%d", (v>0)?r/v/60:0}')
    printf 'chunk %d/%d   %s fps   elapsed %dm   eta %dm\033[K\n' \
      "$(( segs < chunks ? segs+1 : chunks ))" "$chunks" "$fps" "$((el/60))" "$eta"
  else
    printf '\033[1m(no episode being processed)\033[0m\033[K\n'
  fi

  # Upload progress, if one is running. $UPLOAD is the remote .part size, polled
  # on the same slow schedule as the outstanding count.
  local loc
  loc=$(find "$WORK" -maxdepth 2 -name '*.mkv' -not -name '.*' -type f 2>/dev/null | head -1)
  if [ -n "$loc" ] && [ -n "${UPLOAD:-}" ] && [ "${UPLOAD:-0}" -gt 0 ]; then
    local ls; ls=$(stat -c%s "$loc" 2>/dev/null || echo 0)
    [ "$ls" -gt 0 ] && printf 'upload  %s %3d%%   %s/%s MB   %s\033[K\n' \
      "$(bar $(( UPLOAD*100/ls )) 20)" "$(( UPLOAD*100/ls ))" \
      "$((UPLOAD/1048576))" "$((ls/1048576))" "$(basename "${loc%.mkv}" | cut -c1-28)"
  fi

  # Name what runs next. If nothing does, say so - that is the explanation for
  # why an upload is not overlapping any compute.
  local nx='' cand cur=''
  [ -f "$JOB" ] && cur=$(basename "${SRC%.*}")
  while IFS= read -r cand; do
    [ -z "$cand" ] && continue
    cb=$(basename "${cand%.*}")
    [ "$cb" = "$cur" ] && continue
    [ -f "$WORK/$cb/$cb.mkv" ] && continue
    nx="$cb"; break
  done <<< "$(printf '%s\n%s\n' "${NEXT1:-}" "${NEXT2:-}")"
  printf 'state   %s   |   queue %s outstanding\033[K\n' "$act" "$n"
  if [ -n "$nx" ]; then
    printf 'next    %s\033[K\n' "$(echo "$nx" | cut -c1-60)"
  else
    pgrep -f '[u]pscale run|[u]pscale once' >/dev/null 2>&1 &&
      printf 'next    (none queued - nothing to overlap with)\033[K\n' ||
      printf 'next    (queue not running)\033[K\n'
  fi
  resources
}

cmd_status(){                       # live view; Ctrl-C to leave
  # piped or scripted: prime the rate counters, then print one frame and stop
  [ -t 1 ] || { resources >/dev/null 2>&1; sleep 0.3
                UPLOAD=$(upload_size); UPLOAD=${UPLOAD:-0}
                todo=$(discover 2>/dev/null) || todo=''
                OUTSTANDING=$(printf '%s' "$todo" | grep -c . || true) UPLOAD="$UPLOAD" \
                  NEXT1="$(printf '%s\n' "$todo" | sed -n 1p)" \
                  NEXT2="$(printf '%s\n' "$todo" | sed -n 2p)" render; return 0; }
  trap 'printf "\033[?25h\033[J\n"; exit 0' INT TERM
  printf '\033[?25l\033[2J'        # hide cursor, clear once at entry only
  local outstanding='' upload=0 nxt1='' nxt2='' todo='' last=0 now
  while :; do
    now=$(date +%s)
    # the remote count changes once per episode, so poll it rarely; everything
    # else in the frame is local and cheap
    if [ $(( now - last )) -ge "${DISCOVER_EVERY:-20}" ]; then
      todo=$(discover 2>/dev/null) || todo=''
      outstanding=$(printf '%s' "$todo" | grep -c . || true)
      nxt1=$(printf '%s\n' "$todo" | sed -n 1p)
      nxt2=$(printf '%s\n' "$todo" | sed -n 2p)
      upload=$(upload_size); upload=${upload:-0}
      last=$now
    fi
    # render runs in THIS shell, not $(...): a subshell would discard the
    # previous cpu/net sample and both would read as "-" on every frame.
    printf '\033[H'
    OUTSTANDING="$outstanding" UPLOAD="$upload" NEXT1="$nxt1" NEXT2="$nxt2" render
    printf '\033[K\n(live - Ctrl-C to exit)\033[K\033[J'
    sleep "${INTERVAL:-1}"
  done
}

case "${1:-}" in
  list|--list)     discover | nl; exit 0 ;;
  status|--status) cmd_status; exit 0 ;;
  pause|--pause)   touch "$PAUSE"; echo "paused - will hold after the current chunk"; exit 0 ;;
  resume|--resume) rm -f "$PAUSE"; echo "resumed"; exit 0 ;;
  stop|--stop)     touch "$STOP";  echo "stopping after the current episode"; exit 0 ;;
  run|--run)       MODE=run ;;
  once|--once)     MODE=once ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

rm -f "$STOP"
# mark each run: the log is appended across restarts, and the [N] counter
# resets, so without this a resumed episode looks like a duplicate
say "=== run start (pid $$) ==="
deliver_pid=""; done_n=0
while :; do
  [ -f "$STOP" ] && { say "stopped"; break; }
  while [ -f "$PAUSE" ]; do sleep 10; done

  mapfile -t TODO < <(discover || true)
  if [ "${#TODO[@]}" -eq 0 ]; then
    [ -n "$deliver_pid" ] && { wait "$deliver_pid" 2>/dev/null || true; deliver_pid=""; }
    [ "$MODE" = once ] && { say "nothing outstanding"; break; }
    sleep "$IDLE"; continue
  fi

  # Skip anything already processed and merely awaiting upload - it is still
  # "outstanding" from the server's point of view, and re-selecting it would
  # spin instead of starting the next episode, losing the transfer overlap.
  src=""
  for cand in "${TODO[@]}"; do
    cb=$(basename "${cand%.*}")
    [ -f "$WORK/$cb/$cb.mkv" ] && continue
    fc=$(grep -cFx "$cand" "$FAILED" 2>/dev/null) || fc=0
    [ "$fc" -ge "$MAX_FAILS" ] && continue
    src="$cand"; break
  done
  if [ -z "$src" ]; then
    [ -n "$deliver_pid" ] && { wait "$deliver_pid" 2>/dev/null || true; deliver_pid=""; }
    [ "$MODE" = once ] && { say "nothing left to process"; break; }
    sleep 20; continue
  fi
  base=$(basename "${src%.*}")
  say "[$((done_n+1))] processing $base  (${#TODO[@]} outstanding)"

  "$WORKER" fetch "$src"

  # next episode downloads while this one is on the GPU
  prefetch_pid=""
  if [ "${#TODO[@]}" -gt 1 ]; then
    ( "$WORKER" fetch "${TODO[1]}" >/dev/null 2>&1 ) & prefetch_pid=$!
  fi

  # A failing episode must not end the run.
  if ! "$WORKER" process "$src"; then
    fails=$(grep -cFx "$src" "$FAILED" 2>/dev/null) || fails=0
    fails=$((fails + 1))
    printf '%s\n' "$src" >> "$FAILED"
    say "FAILED ($fails/$MAX_FAILS): $base"
    continue
  fi

  # the previous upload must finish before this one starts, so two transfers
  # never split a 2.2 MB/s link between them
  [ -n "$deliver_pid" ] && { wait "$deliver_pid" 2>/dev/null || true; }
  ( "$WORKER" deliver "$src" || say "DELIVERY FAILED: $base" ) & deliver_pid=$!

  [ -n "$prefetch_pid" ] && { wait "$prefetch_pid" 2>/dev/null || true; }
  done_n=$((done_n+1))
  if [ "$LIMIT" -gt 0 ] && [ "$done_n" -ge "$LIMIT" ]; then
    say "limit $LIMIT reached"; break
  fi
done
[ -n "$deliver_pid" ] && { wait "$deliver_pid" 2>/dev/null || true; }
say "queue done: $done_n episode(s) this run"
