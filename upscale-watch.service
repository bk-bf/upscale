[Unit]
Description=Check that both upscale pipelines are making progress

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# --fix restarts only a stalled COLLECTOR, which is safe because it adopts a job
# already running on the box. It never touches the remote worker or the local
# queue's episode: killing work in progress to clear a stall is a worse outcome.
ExecStart=%h/.local/bin/upscale-watch --fix
# a stall is reported through the health file and the log, not by failing here
SuccessExitStatus=0 1
